---
layout: layouts/base.njk
title: House of Worships
description: Explore the spiritual heritage of Piravom through its ancient temples and historic churches.
eleventyExcludeFromCollections: true
permalink: "/house-of-workships/"
---

<main class="mx-auto max-w-7xl px-4 py-8">
    <!-- Hero -->
    {% from "components/page-hero.njk" import pageHero %}
    {{ pageHero(title, description) }}

    {% set categories = ["temple", "church"] %}

    <!-- Worship House Categories -->
    <div class="space-y-12">
        {% for category in categories %}
        <section>
            <h2 class="mb-6 text-2xl font-bold border-b border-gray-200 pb-2 capitalize">{{ category }}s</h2>

            <div class="columns-1 sm:columns-2 lg:columns-3 gap-x-6 space-y-6">
                {% for place in collections["house-of-workships"] %}
                {% if place.data.type == category %}
                <div class="group rounded-3xl border border-gray-200 bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md flex flex-col justify-between break-inside-avoid">
                    <div>
                        <h3 class="text-lg font-bold leading-tight mb-3">{{ place.data.title }}</h3>

                        <div class="flex flex-wrap gap-1.5 mb-3">
                            <span class="rounded-full bg-indigo-50 text-indigo-700 px-2.5 py-0.5 text-xs font-medium">
                                {{ category | capitalize }}
                            </span>
                        </div>

                        <p class="text-sm leading-relaxed text-gray-600 mb-6">{{ place.data.description }}</p>
                    </div>

                    <div class="flex items-center justify-between border-t border-gray-100 pt-4 mt-auto">
                        <span class="text-xs text-gray-400">{{ place.data.distance }}</span>
                        <a href="{{ place.data.mapLink }}" target="_blank" rel="noopener noreferrer"
                           class="rounded-lg p-1.5 text-gray-400 transition hover:bg-gray-100 hover:text-gray-700"
                           title="Open in Maps">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </a>
                    </div>
                </div>
                {% endif %}
                {% endfor %}
            </div>
        </section>
        {% endfor %}
    </div>

    <!-- Bottom Navigation -->


</main>
