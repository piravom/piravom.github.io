---
layout: layouts/base.njk
title: Events
description: Upcoming events, festivals, markets, and community gatherings in and around Piravom.
eleventyExcludeFromCollections: true
permalink: "/events/"
---

<main class="mx-auto max-w-7xl px-4 py-8">

    <!-- Hero -->
    {% from "components/page-hero.njk" import pageHero %}
    {{ pageHero(title, description) }}

    {% set now = "2026-05-21" | toDate %}
    {% set upcoming = collections.events | filterByDate(now, "upcoming") %}
    {% set past = collections.events | filterByDate(now, "past") %}

    {% set categories = collections.events | getCategories %}

    <!-- Mobile Category Filter Strip (horizontal scroll) -->
    <div class="lg:hidden -mx-4 px-4 mb-6 overflow-x-auto scrollbar-hide">
        <nav class="flex gap-2 whitespace-nowrap pb-2">
            <button class="filter-btn flex items-center gap-1.5 rounded-full border border-indigo-200 bg-indigo-50 px-4 py-2 text-sm font-medium text-indigo-700 shadow-sm transition" data-filter="all">
                <span>📋</span>
                <span>All</span>
            </button>
            {% for cat in categories %}
            <button class="filter-btn flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-600 shadow-sm transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700" data-filter="{{ cat | lower }}">
                <span>📌</span>
                <span>{{ cat }}</span>
            </button>
            {% endfor %}
        </nav>
    </div>

    <div class="flex gap-8">

        <!-- Sidebar Filter -->
        <aside class="hidden lg:block w-64 shrink-0">
            <nav class="sticky top-28 space-y-1">
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-3">Filter by Category</p>
                <button class="filter-btn flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-indigo-700 bg-indigo-50 transition hover:bg-indigo-50 hover:text-indigo-700" data-filter="all">
                    <span>📋</span>
                    <span>All</span>
                </button>
                {% for cat in categories %}
                <button class="filter-btn flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-gray-600 transition hover:bg-indigo-50 hover:text-indigo-700" data-filter="{{ cat | lower }}">
                    <span>📌</span>
                    <span>{{ cat }}</span>
                </button>
                {% endfor %}
            </nav>
        </aside>

        <!-- Content -->
        <div class="flex-1 min-w-0">

    <!-- Upcoming Events -->
    {% if upcoming.length %}
    <section class="mb-12">
        <div class="mb-6 flex items-center gap-3">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-green-100">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
            </span>
            <h2 class="text-2xl font-bold text-gray-900">Upcoming Events</h2>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" id="eventsGrid">
            {% for event in upcoming %}
            <div class="event-card rounded-3xl border border-gray-200 bg-white shadow-sm flex flex-col" data-category="{{ event.data.category | lower }}">
                <!-- Date Badge -->
                <div class="flex items-center gap-4 border-b border-gray-100 px-6 py-4">
                    <div class="flex w-14 flex-col items-center rounded-xl bg-indigo-50 py-2">
                        <span class="text-xs font-bold uppercase tracking-wide text-indigo-600">{{ event.data.date | humanDateShortMonth }}</span>
                        <span class="text-2xl font-bold text-indigo-700 leading-none mt-0.5">{{ event.data.date | humanDateDay }}</span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 class="text-lg font-bold text-gray-900 truncate">{{ event.data.name }}</h3>
                        <span class="inline-block mt-1 rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600">{{ event.data.category }}</span>
                    </div>
                </div>

                <!-- Details -->
                <div class="flex-1 px-6 py-4 space-y-3">
                    <p class="text-sm text-gray-600 line-clamp-2">{{ event.data.description }}</p>
                    <div class="flex items-center gap-2 text-xs text-gray-500">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        <span class="truncate">{{ event.data.location }}</span>
                    </div>
                    <div class="flex items-center gap-2 text-xs text-gray-500">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span>{{ event.data.time }}</span>
                    </div>
                </div>

                <!-- Footer -->
                <div class="flex items-center justify-between border-t border-gray-100 px-6 py-3">
                    {% if event.data.organizer %}
                    <span class="text-xs text-gray-400">by {{ event.data.organizer }}</span>
                    {% else %}
                    <span></span>
                    {% endif %}
                    {% if event.data.mapLink %}
                    <a href="{{ event.data.mapLink }}" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 rounded-lg px-3 py-1.5 text-xs font-medium text-gray-500 transition hover:bg-gray-100 hover:text-gray-700">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                        View Map
                    </a>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    <!-- Past Events -->
    {% if past.length %}
    <section>
        <div class="mb-6 flex items-center gap-3">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gray-100">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </span>
            <h2 class="text-2xl font-bold text-gray-900">Past Events</h2>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" id="pastEventsGrid">
            {% for event in past %}
            <div class="event-card rounded-3xl border border-gray-200 bg-white shadow-sm flex flex-col opacity-75" data-category="{{ event.data.category | lower }}">
                <!-- Date Badge -->
                <div class="flex items-center gap-4 border-b border-gray-100 px-6 py-4">
                    <div class="flex w-14 flex-col items-center rounded-xl bg-gray-100 py-2">
                        <span class="text-xs font-bold uppercase tracking-wide text-gray-500">{{ event.data.date | humanDateShortMonth }}</span>
                        <span class="text-2xl font-bold text-gray-500 leading-none mt-0.5">{{ event.data.date | humanDateDay }}</span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 class="text-lg font-bold text-gray-700 truncate">{{ event.data.name }}</h3>
                        <span class="inline-block mt-1 rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-500">{{ event.data.category }}</span>
                    </div>
                </div>

                <!-- Details -->
                <div class="flex-1 px-6 py-4 space-y-3">
                    <p class="text-sm text-gray-500 line-clamp-2">{{ event.data.description }}</p>
                    <div class="flex items-center gap-2 text-xs text-gray-400">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        <span class="truncate">{{ event.data.location }}</span>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

        </div>
    </div>

    <!-- Empty State -->
    {% if not upcoming.length and not past.length %}
    <div class="text-center">
        <div class="rounded-3xl border border-gray-200 bg-white p-12 shadow-sm">
            <span class="text-4xl">📅</span>
            <h3 class="mt-4 text-xl font-bold text-gray-900">No events yet</h3>
            <p class="mt-2 text-sm text-gray-500">Check back soon for upcoming events in Piravom.</p>
        </div>
    </div>
    {% endif %}

    <!-- Bottom Navigation -->


</main>

<script>
    (function () {
        const filterButtons = document.querySelectorAll(".filter-btn");
        const eventCards = document.querySelectorAll(".event-card");

        filterButtons.forEach(function (btn) {
            btn.addEventListener("click", function () {
                const filter = this.dataset.filter;

                filterButtons.forEach(function (b) {
                    b.classList.remove("bg-indigo-50", "text-indigo-700");
                    b.classList.add("text-gray-600");
                });
                this.classList.remove("text-gray-600");
                this.classList.add("bg-indigo-50", "text-indigo-700");

                eventCards.forEach(function (card) {
                    if (filter === "all" || card.dataset.category === filter) {
                        card.style.display = "";
                    } else {
                        card.style.display = "none";
                    }
                });
            });
        });
    })();
</script>
