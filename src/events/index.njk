---
layout: layouts/base.njk
title: Events
description: Upcoming events, festivals, markets, and community gatherings in and around Piravom.
eleventyExcludeFromCollections: true
permalink: '/events/'
---

<main class="mx-auto max-w-7xl px-4 py-8">
  <!-- Hero -->
  {% from "components/page-hero.njk" import pageHero %} {{ pageHero(title, description) }} {% set
  now = "2026-05-21" | toDate %} {% set upcoming = collections.events | filterByDate(now,
  "upcoming") %} {% set past = collections.events | filterByDate(now, "past") %} {% set categories =
  collections.events | getCategories %} {% set categoryEmojis = { "Cultural": "🎭", "Religious":
  "🛐", "Community": "🤝", "Social": "🎉", "All": "📋" } %}

  <!-- Mobile Category Filter Strip (horizontal scroll) -->
  <div class="lg:hidden -mx-4 px-4 mb-6 overflow-x-auto scrollbar-hide">
    <nav class="flex gap-2 whitespace-nowrap pb-2">
      <button
        class="filter-btn flex items-center gap-1.5 rounded-full border border-theme-200 bg-theme-50 px-4 py-2 text-sm font-medium text-theme-700 shadow-sm transition"
        data-filter="all"
      >
        <span>{{ categoryEmojis["All"] or "📋" }}</span>
        <span>All</span>
      </button>
      {% for cat in categories %}
      <button
        class="filter-btn flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-600 shadow-sm transition hover:border-theme-200 hover:bg-theme-50 hover:text-theme-700"
        data-filter="{{ cat | lower }}"
      >
        <span>{{ categoryEmojis[cat] or "📌" }}</span>
        <span>{{ cat }}</span>
      </button>
      {% endfor %}
    </nav>
  </div>

  <div class="flex gap-8">
    <!-- Sidebar Filter -->
    <aside class="hidden lg:block w-64 shrink-0">
      <nav class="sticky top-28 space-y-1">
        <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-3">
          Filter by Category
        </p>
        <button
          class="filter-btn flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-theme-700 bg-theme-50 transition hover:bg-theme-50 hover:text-theme-700"
          data-filter="all"
        >
          <span>{{ categoryEmojis["All"] or "📋" }}</span>
          <span>All</span>
        </button>
        {% for cat in categories %}
        <button
          class="filter-btn flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-gray-600 transition hover:bg-theme-50 hover:text-theme-700"
          data-filter="{{ cat | lower }}"
        >
          <span>{{ categoryEmojis[cat] or "📌" }}</span>
          <span>{{ cat }}</span>
        </button>
        {% endfor %}
      </nav>
    </aside>

    <!-- Content -->
    <div class="flex-1 min-w-0">
      <!-- Upcoming Events -->
      {% if upcoming.length %}
      <section class="mb-12">
        <div class="mb-6 flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-green-100">
            {% lucide "calendar-check", "h-4 w-4 text-green-600" %}
          </span>
          <h2 class="text-2xl font-bold text-gray-900">Upcoming Events</h2>
        </div>

        <div class="grid gap-6 md:grid-cols-2" id="eventsGrid">
          {% for event in upcoming %}
          <div
            class="event-card rounded-3xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-sm flex flex-col"
            data-category="{{ event.data.category | lower }}"
          >
            <!-- Date Badge -->
            <div
              class="flex items-center gap-4 border-b border-gray-100 dark:border-gray-700 px-6 py-4"
            >
              <div
                class="flex w-14 flex-col items-center rounded-xl bg-theme-50 dark:bg-theme-900/30 py-2"
              >
                <span
                  class="text-xs font-bold uppercase tracking-wide text-theme-600 dark:text-theme-400"
                  >{{ event.data.date | humanDateShortMonth }}</span
                >
                <span
                  class="text-2xl font-bold text-theme-700 dark:text-theme-300 leading-none mt-0.5"
                  >{{ event.data.date | humanDateDay }}</span
                >
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-2 mb-1.5">
                  <a
                    href="{{ event.url }}"
                    class="text-lg font-bold leading-tight text-gray-900 dark:text-gray-100 hover:text-theme-600 dark:hover:text-theme-400 transition-colors"
                    >{{ event.data.title }}</a
                  >
                  <span
                    class="shrink-0 rounded-full bg-gray-100 dark:bg-gray-800 px-2.5 py-0.5 text-xs font-medium text-gray-600 dark:text-gray-300"
                    >{{ event.data.category }}</span
                  >
                </div>
              </div>
            </div>

            <!-- Details -->
            <div class="flex-1 px-6 py-4 space-y-3">
              <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2">
                {{ event.data.description }}
              </p>
              <div class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400">
                {% lucide "map-pin", "h-3.5 w-3.5 flex-shrink-0" %}
                <span class="truncate">{{ event.data.location }}</span>
              </div>
              <div class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400">
                {% lucide "clock", "h-3.5 w-3.5 flex-shrink-0" %}
                <span>{{ event.data.time }}</span>
              </div>
            </div>

            <!-- Footer -->
            <div
              class="flex items-center justify-between border-t border-gray-100 dark:border-gray-700 px-6 py-3"
            >
              <span class="text-xs text-gray-400 dark:text-gray-500">
                {%- if event.data.organizer %}by {{ event.data.organizer }}{% endif %}
              </span>
              <a
                href="{{ event.url }}"
                class="flex items-center gap-1 rounded-lg px-3 py-1.5 text-xs font-medium text-theme-600 dark:text-theme-400 transition hover:bg-theme-50 dark:hover:bg-theme-900/30"
              >
                {% lucide "eye", "h-3.5 w-3.5" %} View Event
              </a>
              {% if event.data.mapLink %}
              <a
                href="{{ event.data.mapLink }}"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-1 rounded-lg px-3 py-1.5 text-xs font-medium text-gray-500 dark:text-gray-400 transition hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-700 dark:hover:text-gray-300"
              >
                {% lucide "external-link", "h-3.5 w-3.5" %} Map
              </a>
              {% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      <!-- Past Events -->
      {% if past.length %}
      <section>
        <div class="mb-6 flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gray-100">
            {% lucide "clock", "h-4 w-4 text-gray-500" %}
          </span>
          <h2 class="text-2xl font-bold text-gray-900">Past Events</h2>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" id="pastEventsGrid">
          {% for event in past %}
          <div
            class="event-card rounded-3xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-sm flex flex-col opacity-75"
            data-category="{{ event.data.category | lower }}"
          >
            <!-- Date Badge -->
            <div
              class="flex items-center gap-4 border-b border-gray-100 dark:border-gray-700 px-6 py-4"
            >
              <div
                class="flex w-14 flex-col items-center rounded-xl bg-gray-100 dark:bg-gray-800 py-2"
              >
                <span class="text-xs font-bold uppercase tracking-wide text-gray-500"
                  >{{ event.data.date | humanDateShortMonth }}</span
                >
                <span class="text-2xl font-bold text-gray-500 leading-none mt-0.5"
                  >{{ event.data.date | humanDateDay }}</span
                >
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-2 mb-1.5">
                  <a
                    href="{{ event.url }}"
                    class="text-lg font-bold leading-tight text-gray-700 dark:text-gray-300 hover:text-theme-600 dark:hover:text-theme-400 transition-colors"
                    >{{ event.data.title }}</a
                  >
                  <span
                    class="shrink-0 rounded-full bg-gray-100 dark:bg-gray-800 px-2.5 py-0.5 text-xs font-medium text-gray-500 dark:text-gray-400"
                    >{{ event.data.category }}</span
                  >
                </div>
              </div>
            </div>

            <!-- Details -->
            <div class="flex-1 px-6 py-4 space-y-3">
              <p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-2">
                {{ event.data.description }}
              </p>
              <div class="flex items-center gap-2 text-xs text-gray-400 dark:text-gray-500">
                {% lucide "map-pin", "h-3.5 w-3.5 flex-shrink-0" %}
                <span class="truncate">{{ event.data.location }}</span>
              </div>
            </div>

            <!-- Footer -->
            <div
              class="flex items-center justify-end border-t border-gray-100 dark:border-gray-700 px-6 py-3"
            >
              <a
                href="{{ event.url }}"
                class="flex items-center gap-1 rounded-lg px-3 py-1.5 text-xs font-medium text-theme-600 dark:text-theme-400 transition hover:bg-theme-50 dark:hover:bg-theme-900/30"
              >
                {% lucide "eye", "h-3.5 w-3.5" %} View Event
              </a>
            </div>
          </div>
          {% endfor %}
        </div>
      </section>
      {% endif %}
    </div>
  </div>

  <!-- Empty State -->
  {% if not upcoming.length and not past.length %}
  <div class="text-center">
    <div class="rounded-3xl border border-gray-200 bg-white p-12 shadow-sm">
      <span class="text-4xl">📅</span>
      <h2 class="mt-4 text-xl font-bold text-gray-900">No events yet</h2>
      <p class="mt-2 text-sm text-gray-500">Check back soon for upcoming events in Piravom.</p>
    </div>
  </div>
  {% endif %}

  <!-- Bottom Navigation -->
</main>

<script>
  (function () {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const eventCards = document.querySelectorAll('.event-card');

    filterButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const filter = this.dataset.filter;

        filterButtons.forEach(function (b) {
          b.classList.remove('bg-theme-50', 'text-theme-700');
          b.classList.add('text-gray-600');
        });
        this.classList.remove('text-gray-600');
        this.classList.add('bg-theme-50', 'text-theme-700');

        eventCards.forEach(function (card) {
          if (filter === 'all' || card.dataset.category === filter) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  })();
</script>
