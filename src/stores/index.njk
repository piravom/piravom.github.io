---
layout: layouts/base.njk
title: Stores
description: Explore shops, supermarkets, and local businesses in and around Piravom.
eleventyExcludeFromCollections: true
permalink: "/stores/"
---

<main class="mx-auto max-w-7xl px-4 py-8">

    <!-- Hero -->
    {% from "components/page-hero.njk" import pageHero %}
    {{ pageHero(title, description) }}

    {% set sectionIcons = {
        "Supermarkets & Grocery": "🛒",
        "Textiles & Apparel": "👕",
        "Jewellery": "💎",
        "Opticals": "👓",
        "Hardware & Building Materials": "🔧",
        "Furniture & Home Decor": "🛋️",
        "Stationery & Books": "📚",
        "Pharmacy & Medical Stores": "💊",
        "Other Stores": "🛍️"
    } %}

    {% set grouped = collections.stores | groupByData("section") %}
    {% set sectionKeys = grouped | keys %}

    <!-- Mobile Category Strip (horizontal scroll) -->
    <div class="lg:hidden -mx-4 px-4 mb-6 overflow-x-auto scrollbar-hide">
        <nav class="flex gap-2 whitespace-nowrap pb-2">
            {% for section in sectionKeys %}
            {% set sectionId = section | lower | replace(" ", "-") | replace("&", "and") %}
            <a href="#{{ sectionId }}"
               class="flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-600 shadow-sm transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700">
                <span>{{ sectionIcons[section] or "🛍️" }}</span>
                <span>{{ section }}</span>
            </a>
            {% endfor %}
        </nav>
    </div>

    <div class="flex gap-8">

        <!-- Desktop Sidebar Navigation -->
        <aside class="hidden lg:block w-64 shrink-0">
            <nav class="sticky top-28 space-y-1">
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-3">Categories</p>
                {% for section in sectionKeys %}
                {% set sectionId = section | lower | replace(" ", "-") | replace("&", "and") %}
                <a href="#{{ sectionId }}"
                   class="flex items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-gray-600 transition hover:bg-indigo-50 hover:text-indigo-700">
                    <span>{{ sectionIcons[section] or "🛍️" }}</span>
                    <span>{{ section }}</span>
                </a>
                {% endfor %}
            </nav>
        </aside>

        <!-- Content -->
        <div class="flex-1 min-w-0">

            {% for section in sectionKeys %}
            {% set sectionId = section | lower | replace(" ", "-") | replace("&", "and") %}
            <section id="{{ sectionId }}" class="mb-12 scroll-mt-28">
                <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
                    <span>{{ sectionIcons[section] or "🛍️" }}</span> {{ section }}
                </h2>
                <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                    {% for store in grouped[section] %}
                    <div class="group rounded-3xl border border-gray-200 bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md flex flex-col justify-between">
                        <div>
                            <h3 class="text-lg font-bold leading-tight mb-3">{{ store.data.name }}</h3>

                            {% if store.data.categories %}
                            <div class="flex flex-wrap gap-1.5 mb-3">
                                {% for cat in store.data.categories %}
                                <span class="rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-medium text-indigo-700">{{ cat }}</span>
                                {% endfor %}
                            </div>
                            {% endif %}

                            {% if store.data.description %}
                            <p class="text-sm leading-relaxed text-gray-600">{{ store.data.description }}</p>
                            {% endif %}

                            {% if store.data.address %}
                            <p class="text-xs text-gray-400 mt-2">{{ store.data.address }}</p>
                            {% endif %}
                        </div>

                        <!-- Info Row (attractions style) -->
                        <div class="grid grid-cols-3 items-center border-t border-gray-100 pt-4 mt-auto text-sm">
                            <!-- Distance from Bus Stand -->
                            <span class="text-center font-medium text-indigo-600" title="Distance from Piravom Bus Stand">
                                {{ store.data.distanceFromBusStand or "—" }}
                            </span>

                            <!-- Store Icon -->
                            <span class="flex justify-center text-gray-400" title="Store">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                                </svg>
                            </span>

                            <!-- Navigate to Maps -->
                            <span class="flex justify-center">
                                <a href="{{ store.data.directionsUrl or ("https://maps.google.com/?q=" + store.data.name | replace(" ", "+") + "+PIRAVOM") }}" target="_blank" rel="noopener noreferrer"
                                   class="rounded-lg p-1.5 text-gray-400 transition hover:bg-gray-100 hover:text-gray-700"
                                   title="Open in Maps">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                </a>
                            </span>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </section>
            {% endfor %}

            <!-- Empty State -->
            {% if not sectionKeys.length %}
            <div class="text-center">
                <div class="rounded-3xl border border-gray-200 bg-white p-12 shadow-sm">
                    <span class="text-4xl">🏪</span>
                    <h3 class="mt-4 text-xl font-bold text-gray-900">No stores listed yet</h3>
                    <p class="mt-2 text-sm text-gray-500">Check back soon for store listings in Piravom.</p>
                </div>
            </div>
            {% endif %}

        </div>
    </div>

</main>
