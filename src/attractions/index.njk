---
layout: layouts/base.njk
title: Attractions
description: Explore major viewpoints, parks, and historic sites.
eleventyExcludeFromCollections: true
permalink: "/attractions/"
---

<main class="mx-auto max-w-7xl px-4 py-8">
    <!-- Hero -->
    {% from "components/page-hero.njk" import pageHero %}
    {{ pageHero(title, description) }}

    {% set categories = ["Nature", "Viewpoint", "Park", "Historical", "Religious"] %}

    {% set categoryIcons = {
        "Nature": "🌿",
        "Viewpoint": "👁️",
        "Park": "🌳",
        "Historical": "🏛️",
        "Religious": "⛪"
    } %}

    <!-- Mobile Category Strip (horizontal scroll) -->
    <div class="lg:hidden -mx-4 px-4 mb-6 overflow-x-auto scrollbar-hide">
        <nav class="flex gap-2 whitespace-nowrap pb-2">
            {% for category in categories %}
            {% set catId = category | lower %}
            <a href="#{{ catId }}"
               class="flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-600 shadow-sm transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700">
                <span>{{ categoryIcons[category] }}</span>
                <span>{{ category }}</span>
            </a>
            {% endfor %}
        </nav>
    </div>

    <div class="flex gap-8">

        <!-- Desktop Sidebar Navigation -->
        <aside class="hidden lg:block w-64 shrink-0">
            <nav class="sticky top-28 space-y-1">
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-3">Categories</p>
                {% for category in categories %}
                {% set catId = category | lower %}
                <a href="#{{ catId }}"
                   class="flex items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-gray-600 transition hover:bg-indigo-50 hover:text-indigo-700">
                    <span>{{ categoryIcons[category] }}</span>
                    <span>{{ category }}</span>
                </a>
                {% endfor %}
            </nav>
        </aside>

        <!-- Content -->
        <div class="flex-1 min-w-0">

            {% for category in categories %}
            {% set catId = category | lower %}
            <section id="{{ catId }}" class="mb-12 scroll-mt-28">
                <h3 class="mb-6 text-2xl font-bold border-b border-gray-200 pb-2">{{ categoryIcons[category] }} {{ category }}</h3>

                <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 grid-flow-row-dense">
                    {% for attraction in collections.attractions | sortByDistance %}
                    {% if category in attraction.data.categories %}
                    <div class="group rounded-3xl border border-gray-200 bg-white shadow-sm flex flex-col overflow-hidden {% if attraction.data.image %}row-span-2{% endif %}">
                        {% if attraction.data.image %}
                        <div class="aspect-video w-full bg-gray-100 overflow-hidden">
                            <img src="{{attraction.url}}{{ attraction.data.image }}" alt="{{ attraction.data.name }}" class="h-full w-full object-cover transition duration-500 group-hover:scale-105">
                        </div>
                        {% endif %}

                        <div class="p-6 flex-grow flex flex-col justify-between">
                            <div>
                                <h4 class="text-xl font-bold mb-2">{{ attraction.data.name }}</h4>
                                <p class="text-gray-600 mb-6">{{ attraction.data.description or "" }}</p>
                            </div>

                            <!-- Info Row -->
                            <div class="grid grid-cols-3 items-center border-t border-gray-100 pt-4 mt-auto text-sm">
                                <!-- Distance -->
                                <span class="text-center font-medium text-indigo-600" title="Distance from Piravom Town">
                                    {{ attraction.data.distanceFromBusStand or "—" }}
                                </span>

                                <!-- Category Icon -->
                                <span class="flex justify-center text-gray-400">
                                    {% if category == "Nature" %}
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" title="Nature">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 2L9.5 9.5L2 12l7.5 2.5L12 22l2.5-7.5L22 12l-7.5-2.5L12 2z" />
                                    </svg>
                                    {% elif category == "Viewpoint" %}
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" title="Viewpoint">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                    </svg>
                                    {% elif category == "Park" %}
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" title="Park">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707m12.728 12.728L5.636 5.636" />
                                    </svg>
                                    {% elif category == "Historical" %}
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" title="Historical">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                    </svg>
                                    {% elif category == "Religious" %}
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" title="Religious">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                                    </svg>
                                    {% endif %}
                                </span>

                                <!-- Navigate -->
                                <span class="flex justify-center">
                                    <a href="https://maps.google.com/?q={{ attraction.data.name | replace(' ', '+') }}+Piravom" target="_blank" rel="noopener noreferrer" class="rounded-lg p-1.5 text-gray-400 transition hover:bg-gray-100 hover:text-gray-700" title="Open in Maps">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                        </svg>
                                    </a>
                                </span>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                    {% endfor %}
                </div>
            </section>
            {% endfor %}

        </div>
    </div>

</main>
