---
layout: layouts/base.njk
title: Restaurants
description: Explore the best dining spots around the town.
eleventyExcludeFromCollections: true
eleventyAllowMissingExtension: true

pagination:
  data: collections.restaurants
  size: 40
  alias: restaurants
permalink: '/restaurants/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}'
---

<main class="mx-auto max-w-7xl px-4 py-8">
  <!-- Hero -->
  {% from "components/page-hero.njk" import pageHero %} {{ pageHero(title, description) }}

  <!-- Search -->
  <div class="relative mb-8" id="restaurantSearch">
    <div class="relative">
      {% lucide "search", "absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-400
      dark:text-gray-500" %}
      <input
        type="text"
        id="restaurantSearchInput"
        placeholder="Search restaurants or menu items…"
        autocomplete="off"
        class="w-full rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 py-3.5 pl-12 pr-4 text-base sm:text-sm text-gray-900 dark:text-gray-100 shadow-sm outline-none transition focus:border-theme-200 dark:focus:border-theme-800 focus:ring-2 focus:ring-theme-200 dark:focus:ring-theme-800 focus-visible:outline-none"
      />
    </div>
    <!-- Suggestions dropdown -->
    <div
      id="searchSuggestions"
      class="absolute z-50 mt-1 hidden w-full rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-lg"
    ></div>
  </div>

  <script>
    var RESTAURANT_INDEX = [
    {% for restaurant in pagination.items %}
    {
    name: {{ restaurant.data.restaurant.title | json | safe }},
    url: {{ restaurant.url | json | safe }},
    cuisine: {{ restaurant.data.restaurant.cuisines | json | safe }},
    rating: {{ restaurant.data.restaurant.rating | json | safe }},
    distance: {{ restaurant.data.restaurant.distanceFromBusStand | json | safe }},
    description: {{ restaurant.data.restaurant.description | json | safe }},
    menuItems: [
    {% if restaurant.data.menuList %}
    {% for section in restaurant.data.menuList %}
    {% for item in section.items %}
    { title: {{ item.title | json | safe }}, cat: {{ section.category | json | safe }} },
    {% endfor %}
    {% endfor %}
    {% endif %}
    ],
    menuCategories: [
    {% if restaurant.data.menuList %}
    {% for section in restaurant.data.menuList %}
    {{ section.category | json | safe }},
    {% endfor %}
    {% endif %}
    ]
    }{% if not loop.last %},{% endif %}
    {% endfor %}
    ];
  </script>

  <!-- Restaurant List -->
  <section>
    <div class="space-y-1">
      <section class="columns-1 sm:columns-2 lg:columns-3 gap-x-6 space-y-6" id="restaurantGrid">
        {% for restaurant in pagination.items | sortByDistance %}
        <div
          class="group rounded-3xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md flex flex-col justify-between break-inside-avoid"
        >
          <div>
            <div class="flex items-start justify-between gap-4 mb-3">
              <a
                href="{{ restaurant.url }}"
                class="text-xl font-bold leading-tight text-gray-900 dark:text-gray-100 hover:text-theme-600 dark:hover:text-theme-400 transition-colors"
                >{{ restaurant.data.restaurant.title }}</a
              >
            </div>
            {% set cuisineList = restaurant.data.restaurant.cuisines %}
            <div class="flex flex-wrap gap-1.5 mb-3">
              {% for c in cuisineList %}
              <span
                class="rounded-full bg-theme-50 dark:bg-theme-900/30 px-2.5 py-0.5 text-xs font-medium text-theme-700 dark:text-theme-300"
                >{{ c }}</span
              >
              {% endfor %}
            </div>
            <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-400 mb-6">
              {{ restaurant.data.restaurant.description }}
            </p>
          </div>

          <!-- Info Row (attractions style) -->
          <div
            class="grid grid-cols-5 items-center border-t border-gray-100 dark:border-gray-700 pt-4 mt-auto text-sm"
          >
            <!-- Distance from Bus Stand -->
            <span
              class="text-center font-medium text-theme-600 dark:text-theme-400"
              title="Distance from Piravom Bus Stand"
            >
              {{ restaurant.data.restaurant.distanceFromBusStand or "-" }}
            </span>

            <!-- Phone -->
            <span class="flex justify-center">
              {% if restaurant.data.restaurant.phone %}
              <a
                href="tel:{{ restaurant.data.restaurant.phone | replace(' ', '') }}"
                class="rounded-lg p-1.5 text-gray-400 dark:text-gray-500 transition hover:bg-green-50 dark:hover:bg-green-900/30 hover:text-green-700 dark:hover:text-green-400"
                title="{{ restaurant.data.restaurant.phone }}"
              >
                {% lucide "phone", "h-5 w-5" %}
              </a>
              {% else %}
              <span class="text-gray-300 dark:text-gray-600"></span>
              {% endif %}
            </span>

            <!-- Star Rating -->
            <span
              class="flex items-center justify-center gap-1"
              title="Rating: {{ restaurant.data.restaurant.rating }} out of 5"
            >
              {% if restaurant.data.restaurant.rating %}
              <span class="font-bold text-amber-600 dark:text-amber-400"
                >{{ restaurant.data.restaurant.rating }}</span
              >
              {% lucide "star", "h-4 w-4 text-amber-500 dark:text-amber-400 fill-amber-500
              dark:fill-amber-400 shrink-0" %} {% else %}
              <span class="text-sm text-gray-300 dark:text-gray-600">-</span>
              {% endif %}
            </span>

            <!-- Menu -->
            <span class="flex justify-center">
              {% if restaurant.data.menuList.length %}
              <a
                href="{{ restaurant.url }}"
                class="rounded-lg p-1.5 text-gray-400 dark:text-gray-500 transition hover:bg-orange-50 dark:hover:bg-orange-900/30 hover:text-orange-700 dark:hover:text-orange-400"
                title="View menu"
              >
                {% lucide "utensils-crossed", "h-5 w-5" %}
              </a>
              {% endif %}
            </span>

            <!-- Navigate to Maps -->
            <span class="flex justify-center">
              <a
                href="https://maps.google.com/?q={{ restaurant.data.restaurant.title | replace(' ', '+') }}+Piravom"
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-lg p-1.5 text-gray-400 dark:text-gray-500 transition hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-700 dark:hover:text-gray-300"
                title="Open in Maps"
              >
                {% lucide "map-pin", "h-5 w-5" %}
              </a>
            </span>
          </div>
        </div>
        {% endfor %}
      </section>
    </div>
    {% set entityName = "restaurants" %}
  </section>
</main>

<script>
  (function () {
    var input = document.getElementById('restaurantSearchInput');
    var suggestions = document.getElementById('searchSuggestions');
    var grid = document.getElementById('restaurantGrid');
    var cards = grid ? Array.from(grid.querySelectorAll('.group')) : [];
    var index = typeof RESTAURANT_INDEX !== 'undefined' ? RESTAURANT_INDEX : [];

    if (!input || !suggestions) return;

    function slugify(str) {
      return (str || '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '');
    }

    function normalize(str) {
      return (str || '').toLowerCase().trim();
    }

    function matches(query, text) {
      return normalize(text).indexOf(normalize(query)) !== -1;
    }

    function getResults(query) {
      if (!query || query.length < 1) return [];
      var q = normalize(query);
      var results = [];
      var seen = new Set();

      index.forEach(function (r, idx) {
        // Match restaurant name
        if (matches(q, r.name)) {
          if (!seen.has(r.url)) {
            seen.add(r.url);
            results.push({
              type: 'restaurant',
              label: r.name,
              sub: (r.cuisine || []).join(', '),
              url: r.url,
              idx: idx,
            });
          }
          return;
        }
        // Match cuisine
        if (
          r.cuisine &&
          r.cuisine.some(function (c) {
            return matches(q, c);
          })
        ) {
          if (!seen.has(r.url)) {
            seen.add(r.url);
            results.push({
              type: 'restaurant',
              label: r.name,
              sub: (r.cuisine || []).join(', '),
              url: r.url,
              idx: idx,
            });
          }
          return;
        }
        // Match description
        if (r.description && matches(q, r.description)) {
          if (!seen.has(r.url)) {
            seen.add(r.url);
            results.push({
              type: 'restaurant',
              label: r.name,
              sub: r.description.substring(0, 60),
              url: r.url,
              idx: idx,
            });
          }
          return;
        }
        // Match menu items
        if (r.menuItems && r.menuItems.length) {
          r.menuItems.forEach(function (item) {
            if (matches(q, item.title)) {
              var key = r.url + '|' + item.title;
              if (!seen.has(key)) {
                seen.add(key);
                var catSlug = slugify(item.cat);
                var itemSlug = slugify(item.title);
                var hash = catSlug + '-' + itemSlug;
                results.push({
                  type: 'menu',
                  label: item.title,
                  sub: 'Menu item at ' + r.name,
                  url: r.url + '#' + hash,
                  idx: idx,
                });
              }
            }
          });
        }
        // Match menu categories
        if (r.menuCategories && r.menuCategories.length) {
          r.menuCategories.forEach(function (cat) {
            if (matches(q, cat)) {
              if (!seen.has(r.url + '|cat|' + cat)) {
                seen.add(r.url + '|cat|' + cat);
                var catSlug = slugify(cat);
                results.push({
                  type: 'menu',
                  label: cat,
                  sub: 'Menu section at ' + r.name,
                  url: r.url + '#' + catSlug,
                  idx: idx,
                });
              }
            }
          });
        }
      });

      return results.slice(0, 10);
    }

    function renderSuggestions(results) {
      suggestions.innerHTML = '';
      if (!results.length) {
        suggestions.classList.add('hidden');
        return;
      }
      suggestions.classList.remove('hidden');

      var list = document.createElement('div');
      list.className = 'py-2';

      results.forEach(function (r) {
        var a = document.createElement('a');
        a.href = r.url;
        a.className =
          'flex items-start gap-3 px-4 py-2.5 transition hover:bg-theme-50 dark:hover:bg-theme-900/40';

        var icon = document.createElement('span');
        icon.className = 'mt-0.5 shrink-0';
        icon.textContent = r.type === 'menu' ? '🍽️' : '🏪';

        var textDiv = document.createElement('div');
        textDiv.className = 'min-w-0';

        var label = document.createElement('div');
        label.className = 'text-sm font-medium text-gray-900 dark:text-gray-100';
        label.textContent = r.label;

        var sub = document.createElement('div');
        sub.className = 'text-xs text-gray-500 dark:text-gray-400 truncate';
        sub.textContent = r.sub || '';

        textDiv.appendChild(label);
        textDiv.appendChild(sub);
        a.appendChild(icon);
        a.appendChild(textDiv);
        list.appendChild(a);
      });

      suggestions.appendChild(list);
    }

    function getAllSearchText(r) {
      return normalize(
        (r.name || '') +
          ' ' +
          (r.cuisine || []).join(' ') +
          ' ' +
          (r.description || '') +
          ' ' +
          (r.menuItems || []).join(' ') +
          ' ' +
          (r.menuCategories || []).join(' '),
      );
    }

    var debounceTimer;
    input.addEventListener('input', function () {
      clearTimeout(debounceTimer);
      var val = this.value;
      debounceTimer = setTimeout(function () {
        var results = getResults(val);
        renderSuggestions(results);
      }, 150);
    });

    input.addEventListener('blur', function () {
      setTimeout(function () {
        suggestions.classList.add('hidden');
      }, 200);
    });

    input.addEventListener('focus', function () {
      if (this.value) {
        var results = getResults(this.value);
        renderSuggestions(results);
      }
    });
  })();
</script>
