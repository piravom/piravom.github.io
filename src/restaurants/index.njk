---
layout: layouts/base.njk
title: Restaurants
description: Explore the best dining spots around the town.
eleventyExcludeFromCollections: true
eleventyAllowMissingExtension: true

pagination:
  data: collections.restaurants
  size: 40
  alias: restaurants
permalink: "/restaurants/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}"
---
<main class="mx-auto max-w-7xl px-4 py-8">

    <!-- Hero -->
    {% from "components/page-hero.njk" import pageHero %}
    {{ pageHero(title, description) }}

    <!-- Restaurant List -->
    <section>
        <div class="space-y-1">
            <section class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                {% for restaurant in pagination.items | sortByDistance %}
                <div class="group rounded-3xl border border-gray-200 bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md flex flex-col justify-between">
                    <div>
                        <div class="flex items-start justify-between gap-4 mb-3">
                            <a href="{{ restaurant.url }}" class="text-xl font-bold leading-tight text-gray-900 hover:text-indigo-600 transition-colors">{{ restaurant.data.name }}</a>
                        </div>
                        {% set cuisineList = restaurant.data.cuisine | split %}
                        <div class="flex flex-wrap gap-1.5 mb-3">
                            {% for c in cuisineList %}
                            <span class="rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-medium text-indigo-700">{{ c }}</span>
                            {% endfor %}
                        </div>
                        <p class="text-sm leading-relaxed text-gray-600 mb-6">{{ restaurant.data.description }}</p>
                    </div>

                    <!-- Info Row (attractions style) -->
                    <div class="grid grid-cols-4 items-center border-t border-gray-100 pt-4 mt-auto text-sm">
                        <!-- Distance from Bus Stand -->
                        <span class="text-center font-medium text-indigo-600" title="Distance from Piravom Bus Stand">
                            {{ restaurant.data.distanceFromBusStand or "—" }}
                        </span>

                        <!-- Phone -->
                        <span class="flex justify-center">
                            {% if restaurant.data.contact %}
                            <a href="tel:{{ restaurant.data.contact | replace(' ', '') }}"
                               class="rounded-lg p-1.5 text-gray-400 transition hover:bg-green-50 hover:text-green-700"
                               title="{{ restaurant.data.contact }}">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z" />
                                </svg>
                            </a>
                            {% else %}
                            <span class="text-gray-300"></span>
                            {% endif %}
                        </span>

                        <!-- Star Rating -->
                        <span class="flex items-center justify-center" title="Rating: {{ restaurant.data.rating }} out of 5">
                            {% if restaurant.data.rating %}
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-yellow-400 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2z" />
                            </svg>
                            <span class="ml-1 text-sm font-semibold text-gray-800">{{ restaurant.data.rating }}</span>
                            {% else %}
                            <span class="text-sm text-gray-300">—</span>
                            {% endif %}
                        </span>

                        <!-- Navigate to Maps -->
                        <span class="flex justify-center">
                            <a href="https://maps.google.com/?q={{ restaurant.data.name | replace(' ', '+') }}+Piravom" target="_blank" rel="noopener noreferrer"
                               class="rounded-lg p-1.5 text-gray-400 transition hover:bg-gray-100 hover:text-gray-700"
                               title="Open in Maps">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </a>
                        </span>
                    </div>
                </div>
                {% endfor %}
            </section>
        </div>
        {% set entityName = "restaurants" %}
    </section>
</main>
