# Cloudflare Pages _headers
# Long cache for fingerprinted/image assets, short for HTML

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

*.jpg
  Cache-Control: public, max-age=31536000, immutable

*.png
  Cache-Control: public, max-age=31536000, immutable

*.webp
  Cache-Control: public, max-age=31536000, immutable

*.svg
  Cache-Control: public, max-age=31536000, immutable

*.css
  Cache-Control: public, max-age=31536000, immutable

*.js
  Cache-Control: public, max-age=31536000, immutable

*.woff2
  Cache-Control: public, max-age=31536000, immutable

# HTML pages: short cache so updates are reflected quickly
/*.html
  Cache-Control: public, max-age=0, s-maxage=3600

/
  Cache-Control: public, max-age=0, s-maxage=3600
