---
layout: layouts/base.njk
---

<script type="application/ld+json">
  {
   "@context": "https://schema.org",
   "@type": "LocalBusiness",
   "name": "{{ title | e }}",
   "description": "{{ description | e }}",
   "url": "{{ site.url }}{{ page.url }}",
   {% if rating %}"aggregateRating": {
   "@type": "AggregateRating",
   "ratingValue": "{{ rating }}",
   "bestRating": "5"
   },{% endif %}
   "address": {
   "@type": "PostalAddress",
   "addressLocality": "Piravom",
   "addressRegion": "Kerala",
   "addressCountry": "IN"
   {% if address %},"streetAddress": "{{ address | e }}"{% endif %}
   }
  }
</script>

<main class="mx-auto max-w-7xl px-4 py-8">
  <!-- Breadcrumbs -->
  <nav class="mb-8 flex items-center gap-2 text-sm text-gray-500">
    <a href="/" class="hover:text-black">Piravom</a>
    <span>/</span>
    <a href="/services/" class="hover:text-black">Services</a>
    <span>/</span>
    <span class="font-medium text-black">{{ title }}</span>
  </nav>

  <!-- Service Header -->
  <section class="mb-10">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div class="max-w-2xl">
        <h1 class="text-4xl font-bold tracking-tight md:text-6xl">{{ title }}</h1>
        {% if section %}
        <p class="mt-1 text-sm font-medium text-indigo-600">{{ section }}</p>
        {% endif %}
        <p class="mt-4 text-lg leading-relaxed text-gray-600">{{ description }}</p>
      </div>
      {% if rating %}
      <div class="shrink-0 rounded-2xl border border-gray-200 bg-white p-4">
        <div class="flex items-center gap-1.5">
          {% lucide "star", "h-5 w-5 text-yellow-400" %}
          <p class="text-xl font-bold text-gray-800">{{ rating }}</p>
        </div>
        <p class="text-xs text-gray-500 mt-0.5">Rating</p>
      </div>
      {% endif %}
    </div>

    <!-- Category Tags -->
    {% if categories %}
    <div class="mt-6 flex flex-wrap items-center gap-2">
      {% for cat in categories %}
      <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700">
        {{ cat }}
      </span>
      {% endfor %}
    </div>
    {% endif %}
  </section>

  <!-- Address + Map -->
  {% if address or mapLink %}
  <section class="grid gap-6 md:grid-cols-2">
    {% if address %}
    <div class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm">
      <p class="mb-1 text-sm font-semibold text-gray-500 uppercase tracking-wide">Address</p>
      <p class="text-gray-800">{{ address }}</p>
    </div>
    {% endif %} {% if mapLink %}
    <div class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm">
      <p class="mb-3 text-sm font-semibold text-gray-500 uppercase tracking-wide">Directions</p>
      <a
        href="{{ mapLink }}"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-indigo-700"
      >
        {% lucide "map-pin", "h-4 w-4" %}
        <span>Open in Google Maps</span>
      </a>
    </div>
    {% endif %}
  </section>
  {% endif %}

  <!-- Body Content -->
  {% if content %}
  <section class="mt-10 prose prose-gray max-w-none">{{ content | safe }}</section>
  {% endif %}

  <!-- Back link -->
  <div class="mt-12">
    <a href="/services/" class="text-sm font-semibold text-gray-500 hover:text-black">
      &larr; Back to all services
    </a>
  </div>
</main>
