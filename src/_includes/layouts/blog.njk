---
layout: layouts/base.njk
---

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": "{{ title | e }}",
    "description": "{{ description | e }}",
    "url": "{{ site.url }}{{ page.url }}",
    "datePublished": "{{ date | dateToISO }}",
    {% if author %}
    "author": {
      "@type": "Person",
      "name": "{{ author.name | e }}"
      {% if author.url %}
      ,"url": "{{ author.url | e }}"
      {% endif %}
    },
    {% endif %}
    {% if categories %}
    "keywords": "{{ categories | join(', ') }}"
    {% endif %}
  }
</script>

<main class="mx-auto max-w-7xl px-4 py-8">
  <!-- Breadcrumbs -->
  <nav class="mb-8 flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
    <a href="/" class="hover:text-black dark:hover:text-white transition">Piravom</a>
    <span>/</span>
    <a href="/blog/" class="hover:text-black dark:hover:text-white transition">Blog</a>
    <span>/</span>
    <span class="font-medium text-black dark:text-white">{{ title }}</span>
  </nav>

  <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-10">
    <!-- Main Content -->
    <article>
      <!-- Categories -->
      {% if categories %}
      <div class="mb-4 flex flex-wrap gap-2">
        {% for cat in categories %}
        <a
          href="/blog/?category={{ cat | lower | urlencode }}"
          class="rounded-full bg-theme-50 dark:bg-theme-900/30 px-3.5 py-1 text-xs font-semibold text-theme-700 dark:text-theme-300 transition hover:bg-theme-100 dark:hover:bg-theme-900/50"
        >
          {{ cat }}
        </a>
        {% endfor %}
      </div>
      {% endif %}

      <!-- Title -->
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white md:text-5xl">
        {{ title }}
      </h1>

      <!-- Meta -->
      <div class="mt-4 flex flex-wrap items-center gap-4 text-sm text-gray-500 dark:text-gray-400">
        {% if date %}
        <span class="flex items-center gap-1.5">
          {% lucide "calendar", "h-4 w-4" %} {{ date | dateToISO | toDate | dateFormat("MMMM d,
          yyyy") }}
        </span>
        {% endif %} {% if author %}
        <span class="flex items-center gap-1.5">
          {% lucide "user", "h-4 w-4" %} {% if author.url %}
          <a
            href="{{ author.url }}"
            target="_blank"
            rel="noopener noreferrer"
            class="text-theme-600 dark:text-theme-400 hover:underline"
          >
            {{ author.name }}
          </a>
          {% else %}
          <span>{{ author.name }}</span>
          {% endif %}
        </span>
        {% endif %}
      </div>

      <!-- Featured Image -->
      {% if thumbnail %}
      <div class="mt-6 overflow-hidden rounded-2xl border border-gray-200 dark:border-gray-700">
        <img src="{{ thumbnail }}" alt="{{ title }}" class="w-full object-cover" loading="lazy" />
      </div>
      {% endif %}

      <!-- Body Content -->
      {% if content %}
      <div class="mt-8 prose prose-gray dark:prose-invert max-w-none">{{ content | safe }}</div>
      {% endif %}

      <!-- Tags -->
      {% if tags %} {% set filteredTags = [] %} {% for tag in tags %} {% if tag != "blogs" and tag
      != "all" and tag != "post" and tag != "posts" %} {% set filteredTags =
      (filteredTags.push(tag), filteredTags) %} {% endif %} {% endfor %} {% if filteredTags.length
      %}
      <div class="mt-10 border-t border-gray-200 dark:border-gray-700 pt-8">
        <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-gray-400">Tags</p>
        <div class="flex flex-wrap gap-2">
          {% for tag in filteredTags %}
          <a
            href="/blog/?tag={{ tag | lower | urlencode }}"
            class="rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 px-3 py-1.5 text-xs font-medium text-gray-600 dark:text-gray-400 transition hover:border-theme-300 dark:hover:border-theme-600 hover:text-theme-700 dark:hover:text-theme-300 hover:bg-theme-50 dark:hover:bg-theme-900/30"
          >
            #{{ tag }}
          </a>
          {% endfor %}
        </div>
      </div>
      {% endif %} {% endif %}
    </article>

    <!-- Sidebar -->
    <aside class="mt-10 lg:mt-0">
      <div class="sticky top-28 space-y-6">
        <!-- Share Card -->
        <div
          class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-5 shadow-sm"
        >
          <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-3">Share</p>
          <div class="flex flex-wrap gap-2">
            <a
              href="https://wa.me/?text={{ title | urlencode }}%0A{{ site.url }}{{ page.url | urlencode }}"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1.5 rounded-lg bg-green-100 dark:bg-green-900/40 px-3 py-1.5 text-xs font-medium text-green-700 dark:text-green-300 transition hover:bg-green-200 dark:hover:bg-green-900/60"
            >
              {% lucide "message-circle", "h-3.5 w-3.5" %} WhatsApp
            </a>
            <button
              onclick="copyPageUrl(this)"
              class="flex items-center gap-1.5 rounded-lg bg-gray-100 dark:bg-gray-800 px-3 py-1.5 text-xs font-medium text-gray-600 dark:text-gray-400 transition hover:bg-gray-200 dark:hover:bg-gray-700"
            >
              {% lucide "clipboard", "h-3.5 w-3.5" %}
              <span id="copyLabel">Copy Link</span>
            </button>
          </div>
        </div>

        <!-- Author Card -->
        {% if author %}
        <div
          class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-5 shadow-sm"
        >
          <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-3">Author</p>
          <div class="flex items-center gap-3">
            <div
              class="flex h-10 w-10 items-center justify-center rounded-full bg-theme-100 dark:bg-theme-900/40 text-theme-600 dark:text-theme-400 font-bold text-sm"
            >
              {{ author.name | first }}
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-900 dark:text-gray-100">
                {{ author.name }}
              </p>
              {% if author.url %}
              <a
                href="{{ author.url }}"
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs text-theme-600 dark:text-theme-400 hover:underline"
              >
                {{ author.url | replace("https://", "") | replace("http://", "") | truncate(25,
                true, "…") }}
              </a>
              {% endif %}
            </div>
          </div>
        </div>
        {% endif %}

        <!-- Related Posts (simple - latest 3) -->
        {% set allBlogs = collections.blogs | reverse %} {% set related = [] %} {% for post in
        allBlogs %} {% if post.url != page.url and related.length < 3 %} {% set related =
        (related.push(post), related) %} {% endif %} {% endfor %} {% if related.length %}
        <div
          class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-5 shadow-sm"
        >
          <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-3">
            Recent Posts
          </p>
          <div class="space-y-3">
            {% for post in related %}
            <a href="{{ post.url }}" class="group block">
              <p
                class="text-sm font-medium text-gray-900 dark:text-gray-100 group-hover:text-theme-600 dark:group-hover:text-theme-400 transition line-clamp-2"
              >
                {{ post.data.title }}
              </p>
              {% if post.data.date %}
              <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">
                {{ post.data.date | dateToISO | toDate | dateFormat("MMM d, yyyy") }}
              </p>
              {% endif %}
            </a>
            {% endfor %}
          </div>
          <a
            href="/blog/"
            class="mt-3 inline-block text-xs font-medium text-theme-600 dark:text-theme-400 hover:underline"
          >
            View all posts &rarr;
          </a>
        </div>
        {% endif %}
      </div>
    </aside>
  </div>

  <!-- Back link -->
  <div class="mt-12">
    <a
      href="/blog/"
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-gray-500 hover:text-black dark:text-gray-400 dark:hover:text-white transition"
    >
      {% lucide "arrow-left", "h-4 w-4" %} Back to all posts
    </a>
  </div>
</main>

<script>
  function copyPageUrl(btn) {
    var url = window.location.href;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(url).then(function () {
        showCopied(btn);
      });
    } else {
      // Fallback
      var textarea = document.createElement('textarea');
      textarea.value = url;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);
      showCopied(btn);
    }
  }

  function showCopied(btn) {
    var label = btn.querySelector('#copyLabel');
    if (!label) return;
    var original = label.textContent;
    label.textContent = 'Copied!';
    btn.classList.add(
      'bg-theme-50',
      'dark:bg-theme-900/30',
      'text-theme-700',
      'dark:text-theme-300',
    );
    setTimeout(function () {
      label.textContent = original;
      btn.classList.remove(
        'bg-theme-50',
        'dark:bg-theme-900/30',
        'text-theme-700',
        'dark:text-theme-300',
      );
    }, 2000);
  }
</script>
