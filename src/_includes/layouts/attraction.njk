---
layout: layouts/base.njk
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "{{ name | e }}",
  "description": "{{ description | e }}",
  {% if image %}"image": "{{ site.url }}/attractions/{{ page.fileSlug }}/{{ image }}",{% endif %}
  "url": "{{ site.url }}{{ page.url }}",
  {% if distanceFromBusStand %}"distanceFromBusStand": "{{ distanceFromBusStand | e }}",{% endif %}
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Piravom",
    "addressRegion": "Kerala",
    "addressCountry": "IN"
  },
  "isAccessibleForFree": true,
  "audience": {
    "@type": "Audience",
    "audienceType": "Tourists"
  }
}
</script>

<main class="mx-auto max-w-7xl px-4 py-8">

    <!-- Breadcrumbs -->
    <nav class="mb-8 flex items-center gap-2 text-sm text-gray-500">
        <a href="/" class="hover:text-black">Piravom</a>
        <span>/</span>
        <a href="/attractions/" class="hover:text-black">Attractions</a>
        <span>/</span>
        <span class="text-black font-medium">{{ name }}</span>
    </nav>

    <!-- Attraction Header -->
    <section class="mb-10">
        <div class="flex items-start justify-between flex-wrap gap-4">
            <div>
                <h2 class="text-4xl font-bold tracking-tight md:text-6xl">
                    {{ name }}
                </h2>
                <p class="mt-4 max-w-2xl text-lg text-gray-600">
                    {{ description }}
                </p>
            </div>
            {% if distanceFromBusStand %}
            <div class="rounded-2xl border border-gray-200 bg-white p-4">
                <p class="text-sm text-gray-500">🚏 From Bus Stand</p>
                <p class="text-xl font-bold text-blue-600">
                    {{ distanceFromBusStand }}
                </p>
            </div>
            {% endif %}
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-2 text-sm text-gray-500">
            {% for cat in categories %}
            <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700">
                {{ cat }}
            </span>
            {% endfor %}
        </div>
    </section>

    <!-- Attraction Image -->
    {% if image %}
    <section class="mb-10">
        <div class="aspect-video w-full overflow-hidden rounded-3xl bg-gray-100">
            <img src="/attractions/{{ page.fileSlug }}/{{ image }}" alt="{{ name }}" class="h-full w-full object-cover">
        </div>
    </section>
    {% endif %}

    <!-- Body Content -->
    {% if content %}
    <section class="prose prose-gray max-w-none">
        {{ content | safe }}
    </section>
    {% endif %}

    <!-- Map Link -->
    {% if directionsUrl %}
    <div class="mt-12">
        <a href="{{ directionsUrl }}" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-2 rounded-2xl border border-gray-200 bg-white px-6 py-4 shadow-sm transition hover:shadow-md">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="font-medium text-gray-700">View on Google Maps</span>
        </a>
    </div>
    {% endif %}

    <!-- Back to Attractions -->
    <div class="mt-12">
        <a href="/attractions/" class="text-sm font-semibold text-gray-500 hover:text-black">
            &larr; Back to all attractions
        </a>
    </div>

</main>
