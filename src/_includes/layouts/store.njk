---
layout: layouts/base.njk
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Store",
  "name": "{{ name | e }}",
  "description": "{{ description | e }}",
  "url": "{{ site.url }}{{ page.url }}",
  {% if distanceFromBusStand %}"distanceFromBusStand": "{{ distanceFromBusStand | e }}",{% endif %}
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Piravom",
    "addressRegion": "Kerala",
    "addressCountry": "IN"
    {% if address %},"streetAddress": "{{ address | e }}"{% endif %}
  }
}
</script>

<main class="mx-auto max-w-7xl px-4 py-8">

    <!-- Breadcrumbs -->
    <nav class="mb-8 flex items-center gap-2 text-sm text-gray-500">
        <a href="/" class="hover:text-black">Piravom</a>
        <span>/</span>
        <a href="/stores/" class="hover:text-black">Stores</a>
        <span>/</span>
        <span class="font-medium text-black">{{ name }}</span>
    </nav>

    <!-- Store Header -->
    <section class="mb-10">
        <div class="flex items-start justify-between gap-4 flex-wrap">
            <div class="max-w-2xl">
                <h2 class="text-4xl font-bold tracking-tight md:text-6xl">
                    {{ name }}
                </h2>
                {% if section %}
                <p class="mt-1 text-sm font-medium text-indigo-600">{{ section }}</p>
                {% endif %}
                <p class="mt-4 text-lg leading-relaxed text-gray-600">
                    {{ description }}
                </p>
            </div>
            {% if distanceFromBusStand %}
            <div class="shrink-0 rounded-2xl border border-gray-200 bg-white p-4">
                <p class="text-sm text-gray-500">🚏 From Bus Stand</p>
                <p class="text-xl font-bold text-blue-600">
                    {{ distanceFromBusStand }}
                </p>
            </div>
            {% endif %}
        </div>

        <!-- Category Tags -->
        {% if categories %}
        <div class="mt-6 flex flex-wrap items-center gap-2">
            {% for cat in categories %}
            <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700">
                {{ cat }}
            </span>
            {% endfor %}
        </div>
        {% endif %}
    </section>

    <!-- Address + Map -->
    <section class="grid gap-6 md:grid-cols-2">
        {% if address %}
        <div class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm">
            <p class="mb-1 text-sm font-semibold text-gray-500 uppercase tracking-wide">Address</p>
            <p class="text-gray-800">{{ address }}</p>
        </div>
        {% endif %}

        {% if directionsUrl %}
        <div class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm">
            <p class="mb-3 text-sm font-semibold text-gray-500 uppercase tracking-wide">Directions</p>
            <a href="{{ directionsUrl }}" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-indigo-700">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>Open in Google Maps</span>
            </a>
        </div>
        {% endif %}
    </section>

    <!-- Body Content -->
    {% if content %}
    <section class="mt-10 prose prose-gray max-w-none">
        {{ content | safe }}
    </section>
    {% endif %}

    <!-- Back link -->
    <div class="mt-12">
        <a href="/stores/" class="text-sm font-semibold text-gray-500 hover:text-black">
            &larr; Explore   all stores
        </a>
    </div>

</main>
