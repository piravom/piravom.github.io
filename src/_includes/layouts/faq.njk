---
eleventyComputed:
  title: '{{ title }} | Piravom FAQ'
  description: '{{ description }}'
---

<main class="mx-auto max-w-3xl px-4 py-8">
  <!-- Breadcrumbs -->
  <nav
    class="mb-6 flex items-center gap-2 text-xs font-medium text-gray-400 dark:text-gray-500"
    aria-label="Breadcrumb"
  >
    <a href="/" class="hover:text-gray-600 dark:hover:text-gray-300 transition">Home</a>
    <span aria-hidden="true">/</span>
    <a href="/faq/" class="hover:text-gray-600 dark:hover:text-gray-300 transition">FAQ</a>
    <span aria-hidden="true">/</span>
    <span class="text-gray-600 dark:text-gray-300 truncate max-w-xs">{{ title }}</span>
  </nav>

  <!-- Question -->
  <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white md:text-4xl">
    {{ title }}
  </h1>

  {% if date %}
  <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">
    Updated: {{ date | dateToISO | toDate | dateFormat("MMMM d, yyyy") }}
  </p>
  {% endif %}

  <!-- Category -->
  {% if category %}
  <div class="mt-4">
    <span
      class="inline-block rounded-full bg-theme-50 dark:bg-theme-900/30 px-3 py-1 text-xs font-semibold text-theme-700 dark:text-theme-300"
    >
      {{ category }}
    </span>
  </div>
  {% endif %}

  <!-- Answer -->
  <div class="mt-8 prose prose-gray dark:prose-invert max-w-none">{{ content | safe }}</div>

  <!-- Related - link back -->
  <div class="mt-12 border-t border-gray-200 dark:border-gray-700 pt-8">
    <a
      href="/faq/"
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-gray-500 hover:text-black dark:text-gray-400 dark:hover:text-white transition"
    >
      ← Browse all FAQs
    </a>
  </div>
</main>
