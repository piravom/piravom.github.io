---
layout: layouts/base.njk
---

{% set cuisineList = restaurant.cuisines or cuisine %} {% set phoneNumber = contact or
restaurant.phone or "" %} {% set desc = restaurant.description or description %} {% set logoUrl =
restaurant.logo or "" %}

<script type="application/ld+json">
  {
   "@context": "https://schema.org",
   "@type": "Restaurant",
   "name": "{{ title | e }}",
   "description": "{{ desc | e }}",
   {% if logoUrl %}"image": "{{ logoUrl | e }}",{% endif %}
   "url": "{{ site.url }}{{ page.url }}",
   {% if phoneNumber %}"telephone": "{{ phoneNumber | e }}",{% endif %}
   "servesCuisine": [{% for c in cuisineList %}"{{ c | e }}"{% if not loop.last %},{% endif %}{% endfor %}],
   {% if rating %}"aggregateRating": {
   "@type": "AggregateRating",
   "ratingValue": "{{ rating }}",
   "bestRating": "5",
   "ratingCount": "1"
   },{% endif %}
   "address": {
   "@type": "PostalAddress",
   "addressLocality": "Piravom",
   "addressRegion": "Kerala",
   "addressCountry": "IN"
   },
   {% if restaurant.openingHours %}"openingHoursSpecification": [
   {% for day, hours in restaurant.openingHours %}
   {
   "@type": "OpeningHoursSpecification",
   "dayOfWeek": "{{ day | capitalize }}",
   "opens": "{{ hours.open }}",
   "closes": "{{ hours.close }}"
   }{% if not loop.last %},{% endif %}
   {% endfor %}
   ],{% endif %}
   "hasMenu": "{{ site.url }}{{ page.url }}"
  }
</script>

<main class="mx-auto max-w-7xl px-4 py-8">
  <!-- Breadcrumbs -->
  <nav class="mb-8 flex items-center gap-2 text-sm text-gray-500">
    <a href="/" class="hover:text-black">Piravom</a>
    <span>/</span>
    <a href="/restaurants/" class="hover:text-black">Restaurants</a>
    <span>/</span>
    <span class="text-black font-medium">{{ title }}</span>
  </nav>

  <!-- Restaurant Header -->
  <section class="mb-10">
    <div class="flex items-center justify-between flex-wrap gap-4">
      <div>
        <h1 class="text-4xl font-bold tracking-tight md:text-6xl">{{ title }}</h1>
        <p class="mt-4 max-w-2xl text-lg text-gray-600">{{ restaurant.description }}</p>
      </div>
      <div class="flex flex-col gap-3">
        <div class="rounded-2xl border border-gray-200 bg-white p-4">
          <p class="text-sm text-gray-500">Status</p>
          <p
            class="text-xl font-bold {% if restaurant.status == 'Open' %}text-green-600{% else %}text-red-600{% endif %}"
          >
            {{ status }}
          </p>
        </div>
        {% if distanceFromBusStand %}
        <div class="rounded-2xl border border-gray-200 bg-white p-4">
          <p class="text-sm text-gray-500">🚏 From Bus Stand</p>
          <a
            href="{{ directionsUrl }}"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xl font-bold text-blue-600 hover:text-blue-800 hover:underline"
          >
            {{ distanceFromBusStand }} ↗
          </a>
        </div>
        {% endif %}
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-2 text-sm text-gray-500">
      {% for cuisine in restaurant.cuisines %}
      <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700">
        {{ cuisine }}
      </span>
      {% endfor %}
    </div>
  </section>

  <!-- Menu Sections -->
  <div class="grid gap-8 lg:grid-cols-2">
    {% for section in menuList %}
    <section
      class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm"
      id="{{ section.category | slug }}"
    >
      <h2 class="text-xl font-bold mb-6 pb-2 border-b border-gray-100">{{ section.category }}</h2>

      <div class="space-y-4">
        {% for item in section.items %}
        <div class="flex flex-col gap-1" id="{{ section.category | slug }}-{{ item.title | slug }}">
          <div class="flex items-center justify-between">
            <span class="font-medium text-gray-800">{{ item.title }}</span>
            {% if item.price %}
            <span class="font-mono text-gray-600">{{ item.price }}</span>
            {% endif %}
          </div>

          {% if item.subTitle %}
          <p class="text-xs text-gray-500 italic">{{ item.subTitle }}</p>
          {% endif %} {% if item.portions %}
          <div class="mt-3 space-y-2">
            {% for portion in item.portions %}
            <div class="flex items-center justify-between text-sm border-t border-gray-50 pt-2">
              <span class="text-gray-500">{{ portion.portionSize }}</span>
              <span class="font-mono text-gray-600">{{ portion.price }}</span>
            </div>
            {% endfor %}
          </div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </section>
    {% endfor %}
  </div>

  <!-- Back to Restaurants -->
  <div class="mt-12">
    <a href="/restaurants/" class="text-sm font-semibold text-gray-500 hover:text-black">
      &larr; Explore all restaurants
    </a>
  </div>
</main>
