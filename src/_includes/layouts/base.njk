<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      {% if title %}{{ title }} - {{site.name}}{% else %}{{site.name}} - {{ site.description }}{%
      endif %}
    </title>
    {% if description %}
    <meta name="description" content="{{ description }}" />
    {% endif %}

    <!-- Canonical URL -->
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

    <!-- Open Graph -->
    <meta
      property="og:title"
      content="{% if title %}{{ title }}{% else %}{{ site.name }}{% endif %}"
    />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="{% if title %}{{ title }}{% else %}{{ site.name }}{% endif %}"
    />
    <meta name="twitter:description" content="{{ description or site.description }}" />

    <!-- Favicon & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/assets/img/logo.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32x32.png" />
    <link rel="icon" type="image/x-icon" href="/assets/img/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/apple-touch-icon.png" />
    <link rel="manifest" crossorigin="use-credentials" href="/assets/img/site.webmanifest" />

    <!-- Theme / Dark Mode -->
    <meta name="theme-color" content="#15803d" />
    <meta name="color-scheme" content="light dark" />

    <!-- Apply dark mode BEFORE first paint to prevent white flash -->
    <script>
      (function () {
        var saved = localStorage.getItem('darkMode');
        if (
          saved === 'true' ||
          (saved !== 'false' && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Preconnect for Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Load Google Fonts async (non-render-blocking) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media = 'all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Tailwind CSS (built locally via CLI) ~10 KB gzipped -->
    <link rel="stylesheet" href="/assets/css/style.css" />

    <!-- MS Analytics -->
    {% include "components/analytics.njk" %}
  </head>

  <body
    class="flex min-h-screen flex-col bg-[#fafafa] dark:bg-gray-950 text-[#111111] dark:text-gray-100"
  >
    <!-- Header -->
    {% include "components/header.njk" %}

    <!-- Mobile Menu (outside header to avoid backdrop-filter containment) -->
    <div
      id="mobileMenu"
      class="fixed inset-0 z-50 hidden bg-white/95 dark:bg-gray-900/95 backdrop-blur-sm overflow-y-auto"
    >
      <div
        class="flex h-full flex-col items-center justify-center gap-5 px-4 py-8 text-lg font-medium"
      >
        <a
          href="/attractions"
          class="text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-gray-100 transition"
          onclick="toggleMobileMenu()"
          >Attractions</a
        >
        <a
          href="/restaurants"
          class="text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-gray-100 transition"
          onclick="toggleMobileMenu()"
          >Restaurants</a
        >
        <a
          href="/stores"
          class="text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-gray-100 transition"
          onclick="toggleMobileMenu()"
          >Stores</a
        >
        <a
          href="/events"
          class="text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-gray-100 transition"
          onclick="toggleMobileMenu()"
          >Events</a
        >
        <a
          href="/phonebook"
          class="text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-gray-100 transition"
          onclick="toggleMobileMenu()"
          >Phonebook</a
        >
        <a
          href="/bus-timing"
          class="text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-gray-100 transition"
          onclick="toggleMobileMenu()"
          >Bus Timings</a
        >
        <a
          href="/services"
          class="text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-gray-100 transition"
          onclick="toggleMobileMenu()"
          >Services</a
        >
        <a
          href="/blog"
          class="text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-gray-100 transition"
          onclick="toggleMobileMenu()"
          >Blog</a
        >
        <a
          href="/faq"
          class="text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-gray-100 transition"
          onclick="toggleMobileMenu()"
          >FAQ</a
        >
        <a
          href="/weather"
          class="text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-gray-100 transition"
          onclick="toggleMobileMenu()"
          >Weather</a
        >
        <a
          href="/about"
          class="text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-gray-100 transition"
          onclick="toggleMobileMenu()"
          >About</a
        >
        <a
          href="/contact"
          class="text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-gray-100 transition"
          onclick="toggleMobileMenu()"
          >Contact</a
        >
        <button
          onclick="toggleMobileMenu()"
          class="mt-6 p-2 text-gray-500 dark:text-gray-400 hover:text-black dark:hover:text-gray-100 transition"
          aria-label="Close menu"
        >
          {% lucide "x", "h-8 w-8" %}
        </button>
      </div>
    </div>

    <!-- Main -->
    <div class="grow">{{ content | safe }}</div>

    <!-- Footer -->
    {% include "components/footer.njk" %}

    <script>
      function toggleMobileMenu() {
        document.getElementById('mobileMenu').classList.toggle('hidden');
      }

      // Highlight the current page in desktop nav
      document.addEventListener('DOMContentLoaded', function () {
        var path = window.location.pathname.replace(/\/$/, '');
        var isDark = document.documentElement.classList.contains('dark');
        document.querySelectorAll('.nav-link').forEach(function (link) {
          var href = link.getAttribute('href').replace(/\/$/, '');
          if (href && path.startsWith(href)) {
            link.classList.remove('text-gray-600', 'dark:text-gray-400');
            if (isDark) {
              link.classList.add('text-theme-400', 'bg-theme-900/30');
            } else {
              link.classList.add('text-theme-600', 'bg-theme-50');
            }
          }
        });
      });

      window.toggleDarkMode = function () {
        var html = document.documentElement;
        html.classList.toggle('dark');
        localStorage.setItem('darkMode', html.classList.contains('dark'));
      };
    </script>
  </body>
</html>
