<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{% if title %}{{ title }} - {{site.name}}{% else %}{{site.name}}{% endif %}</title>
    {% if description %}
    <meta name="description" content="{{ description }}">
    {% endif %}

    <!-- Canonical URL -->
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">

    <!-- Open Graph -->
    <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.name }}{% endif %}">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:locale" content="en_IN">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{% if title %}{{ title }}{% else %}{{ site.name }}{% endif %}">
    <meta name="twitter:description" content="{{ description or site.description }}">

    <!-- Theme -->
    <meta name="theme-color" content="#4f46e5">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        body {
            font-family: Inter, ui-sans-serif, system-ui, sans-serif;
        }
    </style>
</head>

<body class="bg-[#fafafa] text-[#111111]">

    <!-- Header -->
    {% include "components/header.njk" %}

    <!-- Main -->
    {{ content | safe }}

    <!-- Mobile Menu Overlay -->
    <div id="mobileMenu" class="fixed inset-0 z-50 hidden bg-white/95 backdrop-blur-sm">
        <div class="flex h-full flex-col items-center justify-center gap-8 text-lg font-medium">
            <a href="/about" class="nav-mobile-link text-gray-600 hover:text-black" onclick="toggleMobileMenu()">About</a>
            <a href="/bus-timing" class="nav-mobile-link text-gray-600 hover:text-black" onclick="toggleMobileMenu()">Bus Timings</a>
            <a href="/restaurants" class="nav-mobile-link text-gray-600 hover:text-black" onclick="toggleMobileMenu()">Restaurants</a>
            <a href="/attractions" class="nav-mobile-link text-gray-600 hover:text-black" onclick="toggleMobileMenu()">Attractions</a>
            <a href="/events" class="nav-mobile-link text-gray-600 hover:text-black" onclick="toggleMobileMenu()">Events</a>
            <a href="/phonebook" class="nav-mobile-link text-gray-600 hover:text-black" onclick="toggleMobileMenu()">Phonebook</a>
            <a href="/stores" class="nav-mobile-link text-gray-600 hover:text-black" onclick="toggleMobileMenu()">Stores</a>
            <a href="/services" class="nav-mobile-link text-gray-600 hover:text-black" onclick="toggleMobileMenu()">Services</a>
            <button onclick="toggleMobileMenu()" class="mt-4 rounded-xl border border-gray-200 px-8 py-3 text-sm text-gray-500 hover:text-black">
                Close
            </button>
        </div>
    </div>

    <!-- Footer -->
    {% include "components/footer.njk" %}

    <script>
        function toggleMobileMenu() {
            document.getElementById("mobileMenu").classList.toggle("hidden");
        }

        // Highlight the current page in desktop nav
        document.addEventListener("DOMContentLoaded", function () {
            var path = window.location.pathname.replace(/\/$/, "");
            document.querySelectorAll(".nav-link").forEach(function (link) {
                var href = link.getAttribute("href").replace(/\/$/, "");
                if (href && path.startsWith(href)) {
                    link.classList.add("text-black", "font-semibold");
                    link.classList.remove("text-gray-600");
                }
            });
        });
    </script>

</body>
</html>
