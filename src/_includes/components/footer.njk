<footer class="mt-16 border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-10 md:flex-row md:items-center md:justify-center"
  >
    <p class="text-xs text-gray-400 dark:text-gray-500 text-center">
      Built and maintained by {% for author in site.author -%} {% if author.url %}<a
        href="{{ author.url }}"
        class="hover:text-gray-600 dark:hover:text-gray-300 transition"
        >{% endif %} {{- author.name -}} {% if author.url %}</a
      >{% endif %} {%- if not loop.last %}, {% endif %} {%- endfor %}
    </p>
  </div>
</footer>
