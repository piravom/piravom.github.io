<header
  class="sticky top-0 z-50 border-b border-gray-200 dark:border-gray-700 bg-white/90 dark:bg-gray-900/90 backdrop-blur"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4">
    <!-- Logo -->
    <div class="flex items-center gap-3">
      <a href="/" class="shrink-0">
        <img
          src="/assets/img/logo.svg"
          alt="{{site.name}}"
          class="h-10 w-10"
          width="40"
          height="40"
        />
      </a>
      <div>
        <div class="text-xl font-bold text-theme-600 dark:text-theme-400">
          <a href="/">{{site.name}}</a>
        </div>
        <p class="text-xs text-gray-500 dark:text-gray-400">{{site.description}}</p>
      </div>
    </div>

    <!-- Desktop Nav -->
    {% include "components/top-nav.njk" %}

    <div class="flex items-center gap-2">
      <!-- Dark Mode Toggle -->
      <button
        onclick="toggleDarkMode()"
        class="rounded-xl border border-gray-200 dark:border-gray-700 p-2 hover:bg-gray-100 dark:hover:bg-gray-800 transition"
        aria-label="Toggle dark mode"
      >
        <span class="dark:hidden"
          >{% lucide "moon", "h-5 w-5 text-gray-600 dark:text-gray-400" %}</span
        >
        <span class="hidden dark:inline"
          >{% lucide "sun", "h-5 w-5 text-gray-600 dark:text-gray-400" %}</span
        >
      </button>

      <!-- Universal Search -->
      <div class="relative hidden lg:block" id="globalSearch">
        <div class="relative">
          {% lucide "search", "absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400
          dark:text-gray-500" %}
          <input
            type="text"
            id="globalSearchInput"
            placeholder="Search restaurants, stores, services…"
            autocomplete="off"
            class="w-72 rounded-2xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 py-2 pl-10 pr-4 text-sm text-gray-900 dark:text-gray-100 outline-none transition focus:bg-white dark:focus:bg-gray-800 focus:border-theme-200 dark:focus:border-theme-800 focus:ring-2 focus:ring-theme-200 dark:focus:ring-theme-800 focus-visible:outline-none"
          />
        </div>
        <div
          id="globalSearchSuggestions"
          class="absolute right-0 z-50 mt-1 hidden w-96 rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-lg"
        ></div>
      </div>

      <!-- Mobile Search + Menu -->
      <div class="flex items-center gap-2 lg:hidden">
        <button
          onclick="toggleMobileSearch()"
          class="rounded-xl border border-gray-200 dark:border-gray-700 p-2"
          aria-label="Search"
        >
          {% lucide "search", "h-5 w-5 text-gray-600 dark:text-gray-400" %}
        </button>
        <button
          onclick="toggleMobileMenu()"
          class="rounded-xl border border-gray-200 dark:border-gray-700 p-2"
        >
          {% lucide "menu", "h-5 w-5 text-gray-600 dark:text-gray-400" %}
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Search Bar (below header) -->
  <div id="mobileSearchBar" class="hidden border-t border-gray-100 dark:border-gray-700 px-4 py-3">
    <div class="relative" id="globalSearchMobile">
      {% lucide "search", "absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400
      dark:text-gray-500" %}
      <input
        type="text"
        id="globalSearchInputMobile"
        placeholder="Search…"
        autocomplete="off"
        class="w-full rounded-2xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 py-2.5 pl-10 pr-4 text-base text-gray-900 dark:text-gray-100 outline-none transition focus:bg-white dark:focus:bg-gray-800 focus:border-theme-200 dark:focus:border-theme-800 focus:ring-2 focus:ring-theme-200 dark:focus:ring-theme-800 focus-visible:outline-none"
      />
      <div
        id="globalSearchSuggestionsMobile"
        class="absolute left-0 right-0 z-50 mt-1 hidden rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-lg"
      ></div>
    </div>
  </div>
</header>

<script>
  var SEARCH_INDEX = [
   {% for item in collections.restaurants %}
   {
   name: {{ ((item.data.restaurant and item.data.restaurant.title) or item.data.title) | json | safe }},
   url: {{ item.url | json | safe }},
   description: {{ ((item.data.restaurant and item.data.restaurant.description) or item.data.description) | json | safe }},
   type: "Restaurant",
   icon: "🍽️"
   },
   {% endfor %}
   {% for item in collections.stores %}
   {
   name: {{ item.data.title | json | safe }},
   url: {{ item.url | json | safe }},
   description: {{ item.data.description | json | safe }},
   type: "Store",
   icon: "🏪"
   },
   {% endfor %}
   {% for item in collections.attractions %}
   {
   name: {{ item.data.title | json | safe }},
   url: {{ item.url | json | safe }},
   description: {{ item.data.description | json | safe }},
   type: "Attraction",
   icon: "🏔️"
   },
   {% endfor %}
   {% for item in collections.services %}
   {
   name: {{ item.data.title | json | safe }},
   url: {{ item.url | json | safe }},
   description: {{ item.data.description | json | safe }},
   type: "Service",
   icon: "🔧"
   },
   {% endfor %}
   {% for item in collections.events %}
   {
   name: {{ item.data.title | json | safe }},
   url: {{ item.url | json | safe }},
   description: {{ item.data.description | json | safe }},
   type: "Event",
   icon: "📅"
   },
   {% endfor %}
   {% for item in collections.blogs %}
   {
   name: {{ item.data.title | json | safe }},
   url: {{ item.url | json | safe }},
   description: {{ item.data.description | json | safe }},
   type: "Blog",
   icon: "📝"
   },
   {% endfor %}
   {% for category in phone_numbers %}
   {% for contact in category.contacts %}
   {
   name: {{ contact.name | json | safe }},
   url: "/phonebook/#{{ category.category | slug }}",
   description: {{ contact.number | json | safe }},
   type: "{{ category.category }}",
   icon: "📞"
   },
   {% endfor %}
   {% endfor %}
  ];

  (function () {
   function slugify(str) {
   return (str || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
   }
   function normalize(str) {
   return (str || '').toLowerCase().trim();
   }
   function matches(query, text) {
   return normalize(text).indexOf(normalize(query)) !== -1;
   }

   function getResults(query) {
   if (!query || query.length < 1) return [];
   var q = normalize(query);
   var nameMatches = [];
   var descMatches = [];
   var seen = new Set();

   SEARCH_INDEX.forEach(function (item) {
   if (matches(q, item.name)) {
   if (!seen.has(item.url)) {
   seen.add(item.url);
   nameMatches.push(item);
   }
   } else if (matches(q, item.description)) {
   if (!seen.has(item.url)) {
   seen.add(item.url);
   descMatches.push(item);
   }
   }
   });

   return nameMatches.concat(descMatches).slice(0, 8);
   }

   function renderSuggestions(results, suggestionsEl) {
   suggestionsEl.innerHTML = '';
   if (!results.length) {
   suggestionsEl.classList.add('hidden');
   return;
   }
   suggestionsEl.classList.remove('hidden');

   var list = document.createElement('div');
   list.className = 'py-2 max-h-80 overflow-y-auto';

   results.forEach(function (r) {
   var a = document.createElement('a');
   a.href = r.url;
   a.className = 'flex items-start gap-3 px-4 py-2.5 transition hover:bg-theme-50 dark:hover:bg-theme-900/40';

   var icon = document.createElement('span');
   icon.className = 'mt-0.5 shrink-0 text-base';
   icon.textContent = r.icon;

   var textDiv = document.createElement('div');
   textDiv.className = 'min-w-0 flex-1';

   var label = document.createElement('div');
   label.className = 'text-sm font-medium text-gray-900 dark:text-gray-100';
   label.textContent = r.name;

   var sub = document.createElement('div');
   sub.className = 'flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400';
   var typeSpan = document.createElement('span');
   typeSpan.className = 'rounded-full bg-theme-50 dark:bg-theme-900/30 px-2 py-0.5 text-xs font-medium text-theme-700 dark:text-theme-300';
   typeSpan.textContent = r.type;
   sub.appendChild(typeSpan);
   if (r.description) {
   var desc = document.createElement('span');
   desc.className = 'truncate dark:text-gray-400';
   desc.textContent = r.description.substring(0, 50);
   sub.appendChild(desc);
   }

   textDiv.appendChild(label);
   textDiv.appendChild(sub);
   a.appendChild(icon);
   a.appendChild(textDiv);
   list.appendChild(a);
   });

   suggestionsEl.appendChild(list);
   }

   function setupSearch(inputId, suggestionsId) {
   var input = document.getElementById(inputId);
   var suggestions = document.getElementById(suggestionsId);
   if (!input || !suggestions) return;

   var debounceTimer;
   input.addEventListener('input', function () {
   clearTimeout(debounceTimer);
   var val = this.value;
   debounceTimer = setTimeout(function () {
   renderSuggestions(getResults(val), suggestions);
   }, 150);
   });

   input.addEventListener('blur', function () {
   setTimeout(function () { suggestions.classList.add('hidden'); }, 200);
   });

   input.addEventListener('focus', function () {
   if (this.value) {
   renderSuggestions(getResults(this.value), suggestions);
   }
   });
   }

   setupSearch('globalSearchInput', 'globalSearchSuggestions');
   setupSearch('globalSearchInputMobile', 'globalSearchSuggestionsMobile');
  })();
</script>
<script>
  function toggleMobileSearch() {
    document.getElementById('mobileSearchBar').classList.toggle('hidden');
    setTimeout(function () {
      var el = document.getElementById('globalSearchInputMobile');
      if (el) el.focus();
    }, 100);
  }
</script>
