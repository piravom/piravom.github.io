---
layout: layouts/base.njk
title: Phonebook
description: Important contact numbers for essential services, hospitals, and government offices in Piravom.
---

<main class="mx-auto max-w-7xl px-4 py-8">
  <!-- Hero -->
  {% from "components/page-hero.njk" import pageHero %} {{ pageHero(title, description) }}

  <!-- Mobile Category Strip (horizontal scroll) -->
  <div class="lg:hidden -mx-4 px-4 mb-6 overflow-x-auto scrollbar-hide">
    <nav class="flex gap-2 whitespace-nowrap pb-2">
      {% for category in phone_numbers %} {% if loop.index0 > 0 %}
      <a
        href="#{{ category.category | slug }}"
        class="flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-600 shadow-sm transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700"
      >
        <span>
          {% if category.category == "Hospitals" %}🏥 {% elif category.category == "Police & Safety"
          %}👮 {% elif category.category == "Public Services" %}🏛️ {% elif category.category ==
          "Banks" %}🏦 {% elif category.category == "Taxi & Transport" %}🚕 {% elif
          category.category == "Petrol Pumps" %}⛽ {% else %}📞{% endif %}
        </span>
        <span>{{ category.category }}</span>
      </a>
      {% endif %} {% endfor %}
    </nav>
  </div>

  <div class="flex gap-8">
    <!-- Sidebar Navigation -->
    <aside class="hidden lg:block w-64 shrink-0">
      <nav class="sticky top-28 space-y-1">
        <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-3">Categories</p>
        {% for category in phone_numbers %} {% if loop.index0 > 0 %}
        <a
          href="#{{ category.category | slug }}"
          class="flex items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-gray-600 transition hover:bg-indigo-50 hover:text-indigo-700"
        >
          <span>
            {% if category.category == "Hospitals" %}🏥 {% elif category.category == "Police &
            Safety" %}👮 {% elif category.category == "Public Services" %}🏛️ {% elif
            category.category == "Banks" %}🏦 {% elif category.category == "Taxi & Transport" %}🚕
            {% elif category.category == "Petrol Pumps" %}⛽ {% else %}📞{% endif %}
          </span>
          <span>{{ category.category }}</span>
        </a>
        {% endif %} {% endfor %}
      </nav>
    </aside>

    <!-- Content -->
    <div class="flex-1 min-w-0">
      <!-- Emergency Banner -->
      <div
        class="mb-8 overflow-hidden rounded-3xl border border-red-200 bg-gradient-to-br from-red-50 to-orange-50 shadow-sm"
      >
        <div class="flex items-center gap-4 border-b border-red-100 bg-red-50 px-6 py-4">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-red-100 text-lg"
            >🚨</span
          >
          <div>
            <h2 class="text-lg font-bold text-red-800">Emergency Contacts</h2>
            <p class="text-sm text-red-600">Dial these numbers in case of an emergency</p>
          </div>
        </div>
        <div class="grid gap-px bg-red-100 sm:grid-cols-2 lg:grid-cols-4">
          {% for contact in phone_numbers[0].contacts %}
          <a
            href="tel:{{ contact.number }}"
            class="flex items-center justify-between bg-white px-6 py-4 transition hover:bg-red-50"
          >
            <span class="font-medium text-gray-800">{{ contact.name }}</span>
            <span class="flex items-center gap-2 font-bold text-red-600">
              {{ contact.number }} {% lucide "phone", "h-4 w-4" %}
            </span>
          </a>
          {% endfor %}
        </div>
      </div>

      <!-- Search -->
      <div class="mb-8 flex justify-end">
        <div class="relative">
          {% lucide "search", "absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400" %}
          <input
            type="text"
            id="phoneSearch"
            placeholder="Search contacts..."
            class="w-56 rounded-2xl border border-gray-200 bg-gray-50 px-4 py-2 pl-10 text-sm outline-none transition focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400"
          />
        </div>
      </div>

      <!-- Phonebook Grid -->
      <section class="columns-1 md:columns-2 gap-x-6 space-y-6" id="phonebookGrid">
        {% for category in phone_numbers %} {% if loop.index0 > 0 %}
        <div
          class="rounded-3xl border border-gray-200 bg-white shadow-sm scroll-mt-28 break-inside-avoid"
          id="{{ category.category | slug }}"
        >
          <!-- Card Header -->
          <div class="border-b border-gray-100 px-6 py-5">
            <div class="flex items-center gap-3">
              <span
                class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-lg"
              >
                {% if category.category == "Hospitals" %}🏥 {% elif category.category == "Police &
                Safety" %}👮 {% elif category.category == "Public Services" %}🏛️ {% elif
                category.category == "Banks" %}🏦 {% elif category.category == "Taxi & Transport"
                %}🚕 {% elif category.category == "Petrol Pumps" %}⛽ {% else %}📞{% endif %}
              </span>
              <div>
                <h2 class="text-xl font-bold text-gray-900">{{ category.category }}</h2>
                <p class="text-xs text-gray-500">
                  {{ category.contacts.length }} contact{{ "s" if category.contacts.length != 1 }}
                </p>
              </div>
            </div>
          </div>

          <!-- Contacts -->
          <div class="divide-y divide-gray-100 px-6">
            {% for contact in category.contacts %}
            <div
              class="flex items-center justify-between py-4 transition hover:bg-gray-50 -mx-6 px-6"
            >
              <span class="text-sm font-medium text-gray-700">{{ contact.name }}</span>
              <a
                href="tel:{{ contact.number }}"
                class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-indigo-600 transition hover:border-indigo-200 hover:bg-indigo-50"
                title="Call {{ contact.name }}"
              >
                {% lucide "phone", "h-4 w-4" %} {{ contact.number }}
              </a>
            </div>
            {% endfor %}
          </div>
        </div>
        {% endif %} {% endfor %}
      </section>

      <!-- Empty State (hidden by default) -->
      <div id="noResults" class="mt-8 hidden text-center">
        <div class="rounded-3xl border border-gray-200 bg-white p-12 shadow-sm">
          <span class="text-4xl">🔍</span>
          <h2 class="mt-4 text-xl font-bold text-gray-900">No contacts found</h2>
          <p class="mt-2 text-sm text-gray-500">Try a different search term</p>
        </div>
      </div>
    </div>
  </div>
</main>

<!-- Search Filter -->
<script>
  (function () {
    const searchInput = document.getElementById('phoneSearch');
    const grid = document.getElementById('phonebookGrid');
    const noResults = document.getElementById('noResults');

    if (!searchInput || !grid || !noResults) return;

    const cards = grid.querySelectorAll('div.rounded-3xl');

    searchInput.addEventListener('input', function () {
      const query = this.value.toLowerCase().trim();
      let anyVisible = false;

      cards.forEach(function (card) {
        const text = card.textContent.toLowerCase();
        const matches = !query || text.includes(query);
        card.style.display = matches ? '' : 'none';
        if (matches) anyVisible = true;
      });

      noResults.classList.toggle('hidden', anyVisible);
      grid.classList.toggle('hidden', !anyVisible);
    });
  })();
</script>
