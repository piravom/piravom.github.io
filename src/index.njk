---
layout: layouts/base.njk
title: Restaurants
description: Find restaurants, attractions, stores, and more near Piravom
---

<main class="mx-auto max-w-7xl px-4 py-8">
    <!-- Hero -->
    {% set pageTitle %}
        Town portal for <strong class="text-indigo-600"><a href="{{ site.url }}">{{ site.name }}</a></strong>
    {% endset %}
    {% from "components/page-hero.njk" import pageHero %}
    {{ pageHero(pageTitle, description) }}

    <!-- Status Cards -->
    <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

        <a href="/stores/" class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
            <div class="flex items-start gap-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-building-store w-10 h-10 text-indigo-500 shrink-0" width="40" height="40" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M3 21l18 0" />
                    <path d="M3 7v1a3 3 0 0 0 6 0v-1m0 1a3 3 0 0 0 6 0v-1m0 1a3 3 0 0 0 6 0v-1h-18l2 -4h14l2 4" />
                    <path d="M5 21l0 -10.15" />
                    <path d="M19 21l0 -10.15" />
                    <path d="M9 21v-4a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v4" />
                </svg>
                <div>
                    <h3 class="text-2xl font-bold text-indigo-600">{{ collections.stores.length }}</h3>
                    <p class="mt-1 text-sm text-gray-500">Shops &amp; businesses in town</p>
                </div>
            </div>
        </a>

        <a href="/attractions/" class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
            <div class="flex items-start gap-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-mountain w-10 h-10 text-green-500 shrink-0" width="40" height="40" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M3 20h18l-6.921 -14.612a2.3 2.3 0 0 0 -4.158 0l-6.921 14.612z" />
                    <path d="M7.5 11l2 2.5l2.5 -2.5l2 3l2.5 -2" />
                </svg>
                <div>
                    <h3 class="text-2xl font-bold text-green-600">{{ collections.attractions.length }}</h3>
                    <p class="mt-1 text-sm text-gray-500">Places to visit nearby</p>
                </div>
            </div>
        </a>

        <a href="/restaurants/" class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
            <div class="flex items-start gap-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-bowl-spoon w-10 h-10 text-orange-500 shrink-0" width="40" height="40" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M4 11h16a1 1 0 0 1 1 1v.5c0 1.5 -2.517 5.573 -4 6.5v1a1 1 0 0 1 -1 1h-8a1 1 0 0 1 -1 -1v-1c-1.687 -1.054 -4 -5 -4 -6.5v-.5a1 1 0 0 1 1 -1z" />
                    <path d="M8 7c1.657 0 3 -.895 3 -2s-1.343 -2 -3 -2s-3 .895 -3 2s1.343 2 3 2" />
                    <path d="M11 5h9" />
                </svg>
                <div>
                    <h3 class="text-2xl font-bold text-orange-600">{{ collections.restaurants.length }}</h3>
                    <p class="mt-1 text-sm text-gray-500">Dining &amp; food spots</p>
                </div>
            </div>
        </a>

        <a href="/services/" class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
            <div class="flex items-start gap-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-tools w-10 h-10 text-blue-500 shrink-0" width="40" height="40" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M3 21h4l13 -13a1.5 1.5 0 0 0 -4 -4l-13 13v4" />
                    <path d="M14.5 5.5l4 4" />
                    <path d="M12 8l-5 -5l-4 4l5 5" />
                    <path d="M7 8l-1.5 1.5" />
                    <path d="M16 12l5 5l-4 4l-5 -5" />
                    <path d="M16 17l-1.5 1.5" />
                </svg>
                <div>
                    <h3 class="text-2xl font-bold text-blue-600">{{ collections.services.length }}</h3>
                    <p class="mt-1 text-sm text-gray-500">Local service providers</p>
                </div>
            </div>
        </a>
    </section>

    <!-- Attractions -->
    <section class="mt-8">
        <div class="mb-6 flex items-center justify-between">
            <h3 class="text-2xl font-bold">Attractions</h3>
            <a href="/attractions/" class="text-sm text-gray-500 hover:text-black">
                View all
            </a>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {% set shownAttractions = collections.attractions | withImage %}
            {% for attraction in shownAttractions.slice(0, 4) %}
                <div class="rounded-3xl border border-gray-200 bg-white shadow-sm flex flex-col overflow-hidden group">
                    {% if attraction.data.image %}
                    <div class="aspect-video w-full bg-gray-100 overflow-hidden">
                        <img src="{{attraction.url}}{{ attraction.data.image }}" alt="{{ attraction.data.name }}" class="h-full w-full object-cover transition duration-500 group-hover:scale-105">
                    </div>
                    {% endif %}

                    <div class="p-6 flex-grow flex flex-col justify-between">
                        <div>
                            <h4 class="text-xl font-bold mb-2">{{ attraction.data.name }}</h4>
                            <p class="text-gray-600 mb-6 line-clamp-2 text-sm">{{ attraction.data.description }}</p>
                        </div>

                        <!-- Info Row -->
                        <div class="grid grid-cols-3 items-center border-t border-gray-100 pt-4 mt-auto">
                            <!-- Column 1: Distance -->
                            <div class="text-sm font-medium text-indigo-600 cursor-help text-center" title="Distance from Piravom Town">
                                {{ attraction.data.distanceFromBusStand or "—" }}
                            </div>

                            <!-- Column 2: Category Icon -->
                            <div class="flex justify-center text-gray-400">
                                {% if "Nature" in attraction.data.categories or "Viewpoint" in attraction.data.categories %}
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" title="Nature & Viewpoints">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21h18M3 7l9-4 9 4M4 10h16v11H4V10z" />
                                </svg>
                                {% elif "Park" in attraction.data.categories %}
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" title="Parks & Leisure">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707m12.728 12.728L5.636 5.636" />
                                </svg>
                                {% elif "Historical" in attraction.data.categories or "Religious" in attraction.data.categories %}
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" title="Historical & Religious">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                </svg>
                                {% endif %}
                            </div>

                            <!-- Column 3: Navigation -->
                            <div class="flex justify-center">
                                <a href="https://www.google.com/maps?q={{ attraction.data.name | replace(' ', '+') }}+Piravom" target="_blank" rel="noopener noreferrer" class="rounded-lg p-1.5 text-gray-400 transition hover:bg-gray-100 hover:text-gray-700" title="Open in Maps">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>

    <!-- Main Grid -->
    <section class="mt-8 grid gap-6 xl:grid-cols-3">

        <!-- Updates -->
        <div class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm xl:col-span-2">

            <div class="mb-6 flex items-center justify-between">
                <h3 class="text-2xl font-bold">Latest Updates</h3>
                <a href="/events/" class="text-sm text-gray-500 hover:text-black transition">
                    View all
                </a>
            </div>

            <div class="-mx-3 space-y-0">

                <div class="flex items-start justify-between border-b border-gray-100 px-3 py-4 transition hover:bg-gray-50 first:rounded-t-lg last:rounded-b-lg last:border-b-0">
                    <div class="flex items-center gap-4">
                        <span class="rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold leading-none text-blue-700">
                            BUS
                        </span>

                        <p>KSRTC to add more morning trips to Kochi tomorrow</p>
                    </div>

                    <span class="shrink-0 text-sm text-gray-400">10m ago</span>
                </div>

                <div class="flex items-start justify-between border-b border-gray-100 px-3 py-4 transition hover:bg-gray-50 first:rounded-t-lg last:rounded-b-lg last:border-b-0">
                    <div class="flex items-center gap-4">
                        <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-semibold leading-none text-green-700">
                            NEWS
                        </span>

                        <p>Water supply interruption in West Hill area on May 21</p>
                    </div>

                    <span class="shrink-0 text-sm text-gray-400">1h ago</span>
                </div>

                <div class="flex items-start justify-between border-b border-gray-100 px-3 py-4 transition hover:bg-gray-50 first:rounded-t-lg last:rounded-b-lg last:border-b-0">
                    <div class="flex items-center gap-4">
                        <span class="rounded-full bg-orange-100 px-3 py-1 text-xs font-semibold leading-none text-orange-700">
                            OFFER
                        </span>

                        <p>20% off at Hotel Aryas this week</p>
                    </div>

                    <span class="shrink-0 text-sm text-gray-400">3h ago</span>
                </div>

            </div>
        </div>

        <!-- Emergency -->
        <div class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm">

            <div class="mb-6 flex items-center justify-between">
                <h3 class="text-2xl font-bold">Emergency</h3>

                <a href="/phonebook/" class="text-sm text-gray-500 hover:text-black transition">
                    View all
                </a>
            </div>

            <div class="space-y-4">

                <div class="flex items-center justify-between border-b border-gray-100 pb-4">
                    <span>Police</span>
                    <span class="font-semibold">100</span>
                </div>

                <div class="flex items-center justify-between border-b border-gray-100 pb-4">
                    <span>Ambulance</span>
                    <span class="font-semibold">108</span>
                </div>

                <div class="flex items-center justify-between border-b border-gray-100 pb-4">
                    <span>Fire & Rescue</span>
                    <span class="font-semibold">101</span>
                </div>

                <div class="flex items-center justify-between">
                    <span>Women Helpline</span>
                    <span class="font-semibold">1091</span>
                </div>

            </div>
        </div>

    </section>

    <!-- Lower Grid -->
    <section class="mt-8 grid gap-6 lg:grid-cols-2">

        <!-- Bus Timings -->
        <div class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm">

            <div class="mb-6 flex items-center justify-between">
                <h3 class="text-2xl font-bold">Next Bus Timings</h3>

                <a href="/bus-timing/" class="text-sm text-gray-500 hover:text-black transition">
                    View all
                </a>
            </div>

            <div class="overflow-x-auto">

                <table class="w-full text-left">

                    <thead class="border-b border-gray-100 text-sm text-gray-500">
                        <tr>
                            <th class="pb-3">Time</th>
                            <th class="pb-3">From</th>
                            <th class="pb-3">To</th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-gray-100 text-sm">

                        {% for bus in buses.slice(0, 3) %}
                        <tr>
                            <td class="py-4 font-mono">{{ bus.time }}</td>
                            <td>{{ bus.from }}</td>
                            <td>{{ bus.to }}</td>
                        </tr>
                        {% endfor %}

                    </tbody>

                </table>
            </div>
        </div>

        <!-- Restaurants -->
        <div class="rounded-3xl border border-gray-200 bg-white p-6">

            <div class="mb-6 flex items-center justify-between">
                <h3 class="text-2xl font-bold">Popular Restaurants</h3>

                <a href="/restaurants/" class="text-sm text-gray-500 hover:text-black">
                    View all
                </a>
            </div>

            <div class="space-y-4">

                {% for restaurant in collections.restaurants.slice(0, 3) %}
                <a href="{{ restaurant.url }}" class="flex items-center justify-between rounded-2xl border border-gray-100 p-4 transition hover:bg-gray-50">
                    <div>
                        <h4 class="font-semibold">{{ restaurant.data.name }}</h4>
                        {% set cuisineList = restaurant.data.cuisine | split %}
                        <div class="flex flex-wrap gap-1 mt-0.5">
                            {% for c in cuisineList %}
                            <span class="rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700">{{ c }}</span>
                            {% endfor %}
                        </div>
                    </div>

                    <span
                        class="restaurant-status text-sm font-medium text-gray-500"
                        data-opening-hours='{{ restaurant.data.restaurant.openingHours | json | safe }}'
                    >
                        Checking...
                    </span>
                </a>
                {% endfor %}

            </div>
        </div>

    </section>

    <!-- Explore -->
    <section class="mt-8 rounded-3xl border border-gray-200 bg-white p-6">

        <div class="mb-6 flex items-center justify-between">
            <h3 class="text-2xl font-bold">Explore Your Town</h3>

            <a href="/attractions/" class="text-sm text-gray-500 hover:text-black transition">
                View all
            </a>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">

            <a href="/attractions/" class="rounded-2xl border border-gray-100 p-6 transition hover:bg-gray-50 group">
                <h4 class="font-semibold group-hover:text-indigo-600">Attractions</h4>
                <p class="mt-2 text-sm text-gray-500">
                    Tourist spots & places
                </p>
            </a>

            <a href="/phonebook/" class="rounded-2xl border border-gray-100 p-6 transition hover:bg-gray-50 group">
                <h4 class="font-semibold group-hover:text-indigo-600">Hospitals</h4>
                <p class="mt-2 text-sm text-gray-500">
                    Hospitals & Clinics
                </p>
            </a>

            <a href="/about/" class="rounded-2xl border border-gray-100 p-6 transition hover:bg-gray-50 group">
                <h4 class="font-semibold group-hover:text-indigo-600">Schools</h4>
                <p class="mt-2 text-sm text-gray-500">
                    Schools & Colleges
                </p>
            </a>

            <a href="/house-of-workships/" class="rounded-2xl border border-gray-100 p-6 transition hover:bg-gray-50 group">
                <h4 class="font-semibold group-hover:text-indigo-600">Houses of Worship</h4>
                <p class="mt-2 text-sm text-gray-500">
                    Temples and Churches
                </p>
            </a>

        </div>
    </section>

</main>

<script>
    (function () {
        const dayNames = ["sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday"];
        const openClass = "text-green-600";
        const closeClass = "text-red-600";

        function timeToMinutes(time) {
            if (!time || !time.includes(":")) {
                return null;
            }

            const [hours, minutes] = time.split(":").map(Number);

            if (Number.isNaN(hours) || Number.isNaN(minutes)) {
                return null;
            }

            return hours * 60 + minutes;
        }

        function isOpenToday(hours, currentMinutes) {
            if (!hours || hours.closed) {
                return false;
            }

            const openMinutes = timeToMinutes(hours.open);
            const closeMinutes = timeToMinutes(hours.close);

            if (openMinutes === null || closeMinutes === null) {
                return false;
            }

            if (openMinutes === closeMinutes) {
                return true;
            }

            if (closeMinutes > openMinutes) {
                return currentMinutes >= openMinutes && currentMinutes < closeMinutes;
            }

            return currentMinutes >= openMinutes;
        }

        function isRestaurantOpen(openingHours, now) {
            if (!openingHours) {
                return false;
            }

            const todayIndex = now.getDay();
            const currentMinutes = now.getHours() * 60 + now.getMinutes();
            const today = openingHours[dayNames[todayIndex]];
            const yesterday = openingHours[dayNames[(todayIndex + 6) % 7]];

            if (isOpenToday(today, currentMinutes)) {
                return true;
            }

            if (!yesterday || yesterday.closed) {
                return false;
            }

            const yesterdayOpen = timeToMinutes(yesterday.open);
            const yesterdayClose = timeToMinutes(yesterday.close);

            return yesterdayOpen !== null
                && yesterdayClose !== null
                && yesterdayClose <= yesterdayOpen
                && currentMinutes < yesterdayClose;
        }

        document.querySelectorAll(".restaurant-status").forEach(function (statusElement) {
            let openingHours = null;

            try {
                openingHours = JSON.parse(statusElement.dataset.openingHours || "null");
            } catch (error) {
                openingHours = null;
            }

            const isOpen = isRestaurantOpen(openingHours, new Date());

            statusElement.textContent = isOpen ? "Open" : "Closed";
            statusElement.classList.remove("text-gray-500", openClass, closeClass);
            statusElement.classList.add(isOpen ? openClass : closeClass);
        });
    })();
</script>
