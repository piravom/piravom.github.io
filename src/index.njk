---
layout: layouts/base.njk
title: Restaurants
description: Find restaurants, attractions, stores, and more near Piravom
---

<main>
  <div class="mx-auto max-w-7xl px-4 py-8">
    <!-- Jumbo Hero -->
    <section
      class="hero-jumbo flex items-center justify-center overflow-hidden rounded-[2.5rem] border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-sm"
    >
      <div class="mx-auto max-w-4xl px-6 py-16 sm:px-8 sm:py-20 text-center">
        <h1 class="text-4xl font-bold text-gray-900 dark:text-gray-100 sm:text-5xl">
          Welcome to&nbsp;<span class="text-theme-600 dark:text-theme-400">{{ site.name }}</span>
        </h1>
        <p
          class="mx-auto mt-4 max-w-2xl text-base text-gray-700 dark:text-gray-300 sm:text-lg/relaxed"
        >
          {{ description }}
        </p>
        <div class="mt-10 flex items-center justify-center">
          <a
            href="/about/"
            class="rounded-full bg-theme-600 px-10 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-theme-700 hover:shadow-md cursor-pointer inline-block"
            title="Explore {{ site.name }}"
          >
            Explore
          </a>
        </div>
      </div>
    </section>

    <!-- Status Cards -->
    <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4 mt-8">
      <a
        href="/stores/"
        class="rounded-3xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
      >
        <div class="flex items-start gap-4">
          {% lucide "store", "w-10 h-10 text-theme-500 dark:text-theme-400 shrink-0" %}
          <div>
            <h3 class="text-2xl font-bold text-theme-600 dark:text-theme-400">
              {{ collections.stores.length }}
            </h3>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
              Shops &amp; businesses in town
            </p>
          </div>
        </div>
      </a>

      <a
        href="/attractions/"
        class="rounded-3xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
      >
        <div class="flex items-start gap-4">
          {% lucide "mountain", "w-10 h-10 text-theme-500 dark:text-theme-400 shrink-0" %}
          <div>
            <h3 class="text-2xl font-bold text-theme-600 dark:text-theme-400">
              {{ collections.attractions.length }}
            </h3>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Places to visit nearby</p>
          </div>
        </div>
      </a>

      <a
        href="/restaurants/"
        class="rounded-3xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
      >
        <div class="flex items-start gap-4">
          {% lucide "utensils", "w-10 h-10 text-theme-500 dark:text-theme-400 shrink-0" %}
          <div>
            <h3 class="text-2xl font-bold text-theme-600 dark:text-theme-400">
              {{ collections.restaurants.length }}
            </h3>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Dining &amp; food spots</p>
          </div>
        </div>
      </a>

      <a
        href="/services/"
        class="rounded-3xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
      >
        <div class="flex items-start gap-4">
          {% lucide "wrench", "w-10 h-10 text-theme-500 dark:text-theme-400 shrink-0" %}
          <div>
            <h3 class="text-2xl font-bold text-theme-600 dark:text-theme-400">
              {{ collections.services.length }}
            </h3>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Local service providers</p>
          </div>
        </div>
      </a>
    </section>

    <!-- Attractions -->
    <section class="mt-8">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-2xl font-bold dark:text-gray-100">Attractions</h2>
        <a
          href="/attractions/"
          class="text-sm text-gray-500 dark:text-gray-400 hover:text-black dark:hover:text-gray-100"
        >
          View all
        </a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {% set shownAttractions = collections.attractions | withImage %} {% for attraction in
        shownAttractions.slice(0, 4) %}
        <div
          class="rounded-3xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-sm flex flex-col overflow-hidden group"
        >
          {% if attraction.data.image %}
          <div class="aspect-video w-full bg-gray-100 dark:bg-gray-800 overflow-hidden">
            <img
              src="{{attraction.url}}{{ attraction.data.image }}"
              alt="{{ attraction.data.title }}"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />
          </div>
          {% endif %}

          <div class="p-6 flex-grow flex flex-col justify-between">
            <div>
              <h3 class="text-xl font-bold mb-2 dark:text-gray-100">{{ attraction.data.title }}</h3>
              <p class="text-gray-600 dark:text-gray-400 mb-6 line-clamp-2 text-sm">
                {{ attraction.data.description }}
              </p>
            </div>

            <!-- Info Row -->
            <div
              class="grid grid-cols-3 items-center border-t border-gray-100 dark:border-gray-700 pt-4 mt-auto"
            >
              <!-- Column 1: Distance -->
              <div
                class="text-sm font-medium text-theme-600 dark:text-theme-400 cursor-help text-center"
                title="Distance from Piravom Town"
              >
                {{ attraction.data.distanceFromBusStand or "-" }}
              </div>

              <!-- Column 2: Category Icon -->
              <div class="flex justify-center text-gray-400 dark:text-gray-500">
                {% if "Nature" in attraction.data.categories or "Viewpoint" in
                attraction.data.categories %} {% lucide "tree-pine", "h-6 w-6" %} {% elif "Park" in
                attraction.data.categories %} {% lucide "sun", "h-6 w-6" %} {% elif "Historical" in
                attraction.data.categories or "Religious" in attraction.data.categories %} {% lucide
                "landmark", "h-6 w-6" %} {% endif %}
              </div>

              <!-- Column 3: Navigation -->
              <div class="flex justify-center">
                <a
                  href="https://www.google.com/maps?q={{ attraction.data.title | replace(' ', '+') }}+Piravom"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-lg p-1.5 text-gray-400 dark:text-gray-500 transition hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-700 dark:hover:text-gray-300"
                  title="Open in Maps"
                >
                  {% lucide "map-pin", "h-5 w-5" %}
                </a>
              </div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </section>

    <!-- Main Grid -->
    <section class="mt-8 grid gap-6 xl:grid-cols-3">
      <!-- Updates -->
      <div
        class="rounded-3xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6 shadow-sm"
      >
        <div class="mb-6 flex items-center justify-between">
          <h2 class="text-2xl font-bold dark:text-gray-100">Latest Updates</h2>
          <a
            href="/events/"
            class="text-sm text-gray-500 dark:text-gray-400 hover:text-black dark:hover:text-gray-100 transition"
          >
            View all
          </a>
        </div>

        <div class="-mx-3 space-y-0">
          <div
            class="flex items-start justify-between border-b border-gray-100 dark:border-gray-700 px-3 py-4 transition hover:bg-gray-50 dark:hover:bg-gray-800/50 first:rounded-t-lg last:rounded-b-lg last:border-b-0"
          >
            <div class="flex items-center gap-4">
              <span
                class="rounded-full bg-blue-100 dark:bg-blue-900/50 px-3 py-1 text-xs font-semibold leading-none text-blue-700 dark:text-blue-300"
              >
                BUS
              </span>

              <p class="dark:text-gray-300">KSRTC to add more morning trips to Kochi tomorrow</p>
            </div>

            <span class="shrink-0 text-sm text-gray-400 dark:text-gray-500">10m ago</span>
          </div>

          <div
            class="flex items-start justify-between border-b border-gray-100 dark:border-gray-700 px-3 py-4 transition hover:bg-gray-50 dark:hover:bg-gray-800/50 first:rounded-t-lg last:rounded-b-lg last:border-b-0"
          >
            <div class="flex items-center gap-4">
              <span
                class="rounded-full bg-green-100 dark:bg-green-900/50 px-3 py-1 text-xs font-semibold leading-none text-green-700 dark:text-green-300"
              >
                NEWS
              </span>

              <p class="dark:text-gray-300">
                Water supply interruption in West Hill area on May 21
              </p>
            </div>

            <span class="shrink-0 text-sm text-gray-400 dark:text-gray-500">1h ago</span>
          </div>

          <div
            class="flex items-start justify-between border-b border-gray-100 dark:border-gray-700 px-3 py-4 transition hover:bg-gray-50 dark:hover:bg-gray-800/50 first:rounded-t-lg last:rounded-b-lg last:border-b-0"
          >
            <div class="flex items-center gap-4">
              <span
                class="rounded-full bg-orange-100 dark:bg-orange-900/50 px-3 py-1 text-xs font-semibold leading-none text-orange-700 dark:text-orange-300"
              >
                OFFER
              </span>

              <p class="dark:text-gray-300">20% off at Hotel Aryas this week</p>
            </div>

            <span class="shrink-0 text-sm text-gray-400 dark:text-gray-500">3h ago</span>
          </div>
        </div>
      </div>

      <!-- Weather Widget -->
      <div
        class="rounded-3xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6 shadow-sm"
      >
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Weather</h2>
          <a
            href="/weather/"
            class="text-sm text-gray-500 dark:text-gray-400 hover:text-black dark:hover:text-gray-100 transition"
            >View all</a
          >
        </div>

        <!-- Loading -->
        <div id="weatherWidgetLoading" class="flex flex-col items-center gap-2 py-6">
          <div class="h-8 w-8 animate-pulse rounded-lg bg-gray-200 dark:bg-gray-700"></div>
          <div class="h-4 w-20 animate-pulse rounded bg-gray-200 dark:bg-gray-700"></div>
          <div class="h-3 w-36 animate-pulse rounded bg-gray-200 dark:bg-gray-700"></div>
        </div>

        <!-- Loaded content (hidden initially) -->
        <div id="weatherWidgetContent" class="hidden">
          <!-- Current (clickable) -->
          <a href="/weather/" class="flex items-center gap-3 mb-5 no-underline">
            <div
              id="weatherWidgetIcon"
              class="flex items-center justify-center w-12 h-12 text-theme-500 dark:text-theme-400 shrink-0"
              aria-hidden="true"
            ></div>
            <div class="flex-1 min-w-0">
              <div class="flex items-baseline gap-1">
                <span
                  id="weatherWidgetTemp"
                  class="text-2xl font-bold text-gray-900 dark:text-gray-100"
                  >--</span
                >
                <span class="text-xs text-gray-400 dark:text-gray-500">°C</span>
              </div>
              <p
                id="weatherWidgetDesc"
                class="text-xs text-gray-600 dark:text-gray-400 capitalize truncate"
              >
                --
              </p>
              <p class="text-[11px] text-gray-400 dark:text-gray-500" aria-hidden="true">
                💧<span id="weatherWidgetHumidity">--</span>% · 💨<span id="weatherWidgetWind"
                  >--</span
                >
              </p>
            </div>
          </a>

          <!-- 3-Day Forecast -->
          <table
            id="weatherWidgetForecast"
            class="w-full pt-4 border-t border-gray-100 dark:border-gray-700 text-sm"
          >
            <tbody>
              <!-- Injected by JS -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- Emergency -->
      <div
        class="rounded-3xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6 shadow-sm"
      >
        <div class="mb-6 flex items-center justify-between">
          <h2 class="text-2xl font-bold dark:text-gray-100">Emergency</h2>

          <a
            href="/phonebook/"
            class="text-sm text-gray-500 dark:text-gray-400 hover:text-black dark:hover:text-gray-100 transition"
          >
            View all
          </a>
        </div>

        <div class="space-y-4">
          <div
            class="flex items-center justify-between border-b border-gray-100 dark:border-gray-700 pb-4"
          >
            <span class="dark:text-gray-300">Police</span>
            <span class="font-semibold dark:text-gray-100">100</span>
          </div>

          <div
            class="flex items-center justify-between border-b border-gray-100 dark:border-gray-700 pb-4"
          >
            <span class="dark:text-gray-300">Ambulance</span>
            <span class="font-semibold dark:text-gray-100">108</span>
          </div>

          <div
            class="flex items-center justify-between border-b border-gray-100 dark:border-gray-700 pb-4"
          >
            <span class="dark:text-gray-300">Fire & Rescue</span>
            <span class="font-semibold dark:text-gray-100">101</span>
          </div>

          <div class="flex items-center justify-between">
            <span class="dark:text-gray-300">Women Helpline</span>
            <span class="font-semibold dark:text-gray-100">1091</span>
          </div>
        </div>
      </div>

      <!-- Emergency -->
    </section>

    <!-- Lower Grid -->
    <section class="mt-8 grid gap-6 lg:grid-cols-2">
      <!-- Bus Timings -->
      <div
        class="rounded-3xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6 shadow-sm"
      >
        <div class="mb-6 flex items-center justify-between">
          <h2 class="text-2xl font-bold dark:text-gray-100">Next Bus Timings</h2>

          <a
            href="/bus-timing/"
            class="text-sm text-gray-500 dark:text-gray-400 hover:text-black dark:hover:text-gray-100 transition"
          >
            View all
          </a>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead
              class="border-b border-gray-100 dark:border-gray-700 text-sm text-gray-500 dark:text-gray-400"
            >
              <tr>
                <th class="pb-3">Time</th>
                <th class="pb-3">From</th>
                <th class="pb-3">To</th>
              </tr>
            </thead>

            <tbody class="divide-y divide-gray-100 dark:divide-gray-700 text-sm dark:text-gray-300">
              {% for bus in buses.slice(0, 3) %}
              <tr>
                <td class="py-4 font-mono dark:text-gray-100">{{ bus.time }}</td>
                <td>{{ bus.from }}</td>
                <td>{{ bus.to }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Restaurants -->
      <div
        class="rounded-3xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6"
      >
        <div class="mb-6 flex items-center justify-between">
          <h2 class="text-2xl font-bold dark:text-gray-100">Popular Restaurants</h2>

          <a
            href="/restaurants/"
            class="text-sm text-gray-500 dark:text-gray-400 hover:text-black dark:hover:text-gray-100"
          >
            View all
          </a>
        </div>

        <div class="space-y-4">
          {% for restaurant in collections.restaurants.slice(0, 3) %}
          <div
            class="flex items-center justify-between rounded-2xl border border-gray-100 dark:border-gray-700 p-4 transition hover:bg-gray-50 dark:hover:bg-gray-800/50"
          >
            <div class="min-w-0 flex-1">
              <h3 class="font-semibold dark:text-gray-100">
                {{ restaurant.data.restaurant.title }}
              </h3>
              <div class="flex flex-wrap gap-1 mt-0.5">
                {% for c in restaurant.data.restaurant.cuisines %}
                <span
                  class="rounded-full bg-theme-50 dark:bg-theme-900/30 px-2 py-0.5 text-xs font-medium text-theme-700 dark:text-theme-300"
                  >{{ c }}</span
                >
                {% endfor %}
              </div>
            </div>

            <div class="flex items-center gap-2 shrink-0 ml-3">
              {% if restaurant.data.menuList.length %}
              <a
                href="{{ restaurant.url }}"
                class="flex items-center gap-1 rounded-xl bg-theme-50 dark:bg-theme-900/30 px-3 py-1.5 text-xs font-medium text-theme-600 dark:text-theme-400 transition hover:bg-theme-100 dark:hover:bg-theme-900/50"
              >
                {% lucide "utensils-crossed", "h-3.5 w-3.5" %} Menu
              </a>
              {% endif %}
              <a
                href="https://maps.google.com/maps?q={{ restaurant.data.restaurant.title | replace(' ', '+') }}+Piravom"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-1 rounded-xl border border-gray-200 dark:border-gray-700 px-3 py-1.5 text-xs font-medium text-gray-500 dark:text-gray-400 transition hover:bg-gray-100 dark:hover:bg-gray-800"
              >
                {% lucide "map-pin", "h-3.5 w-3.5" %} Navigate
              </a>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- Blog + FAQ Grid -->
    <section class="mt-8 grid gap-6 lg:grid-cols-2">
      <!-- Recent Blog Posts -->
      <div
        class="rounded-3xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6 shadow-sm"
      >
        <div class="mb-6 flex items-center justify-between">
          <h2 class="text-2xl font-bold dark:text-gray-100">Recent Blog Posts</h2>
          <a
            href="/blog/"
            class="text-sm text-gray-500 dark:text-gray-400 hover:text-black dark:hover:text-gray-100 transition"
          >
            View all
          </a>
        </div>

        <div class="space-y-4">
          {% for post in collections.blogs.slice(0, 3) %}
          <a
            href="{{ post.url }}"
            class="block rounded-2xl border border-gray-100 dark:border-gray-700 p-4 transition hover:bg-gray-50 dark:hover:bg-gray-800/50"
          >
            <div class="flex items-start gap-4">
              {% if post.data.thumbnail %}
              <div
                class="w-16 h-16 shrink-0 rounded-xl overflow-hidden bg-gray-100 dark:bg-gray-800"
              >
                <img
                  src="{{ post.url }}{{ post.data.thumbnail }}"
                  alt=""
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
              </div>
              {% endif %}
              <div class="min-w-0 flex-1">
                <h3 class="font-semibold dark:text-gray-100 line-clamp-2">{{ post.data.title }}</h3>
                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
                  {{ post.date | dateFormat("MMM dd, yyyy") }} · {{ post.data.author.name or
                  "Piravom Team" }}
                </p>
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400 line-clamp-2">
                  {{ post.data.description }}
                </p>
              </div>
            </div>
          </a>
          {% endfor %}
        </div>
      </div>

      <!-- Frequently Asked Questions -->
      <div
        class="rounded-3xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6 shadow-sm"
      >
        <div class="mb-6 flex items-center justify-between">
          <h2 class="text-2xl font-bold dark:text-gray-100">Frequently Asked Questions</h2>
          <a
            href="/faq/"
            class="text-sm text-gray-500 dark:text-gray-400 hover:text-black dark:hover:text-gray-100 transition"
          >
            View all
          </a>
        </div>

        <div class="space-y-3">
          {% for faq in collections.faqs.slice(0, 4) %}
          <details
            class="group rounded-xl border border-gray-100 dark:border-gray-700 overflow-hidden transition hover:bg-gray-50 dark:hover:bg-gray-800/50"
          >
            <summary
              class="flex cursor-pointer items-center justify-between gap-2 px-4 py-3 text-sm font-medium text-gray-900 dark:text-gray-100"
            >
              <span class="flex-1">{{ faq.data.title | replace(" | Piravom FAQ", "") }}</span>
              {% lucide "chevron-down", "h-4 w-4 shrink-0 text-gray-400 transition
              group-open:rotate-180" %}
            </summary>
            <div
              class="px-4 pb-4 text-sm text-gray-600 dark:text-gray-400 leading-relaxed prose prose-sm prose-gray dark:prose-invert max-w-none"
            >
              {{ faq.templateContent | safe }}
            </div>
          </details>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- Explore -->
    <section
      class="mt-8 rounded-3xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6"
    >
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-2xl font-bold dark:text-gray-100">Explore Your Town</h2>

        <a
          href="/attractions/"
          class="text-sm text-gray-500 dark:text-gray-400 hover:text-black dark:hover:text-gray-100 transition"
        >
          View all
        </a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <a
          href="/attractions/"
          class="rounded-2xl border border-gray-100 dark:border-gray-700 p-6 transition hover:bg-gray-50 dark:hover:bg-gray-800/50 group"
        >
          <h3
            class="font-semibold dark:text-gray-100 group-hover:text-theme-600 dark:group-hover:text-theme-400"
          >
            Attractions
          </h3>
          <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Tourist spots & places</p>
        </a>

        <a
          href="/phonebook/"
          class="rounded-2xl border border-gray-100 dark:border-gray-700 p-6 transition hover:bg-gray-50 dark:hover:bg-gray-800/50 group"
        >
          <h3
            class="font-semibold dark:text-gray-100 group-hover:text-theme-600 dark:group-hover:text-theme-400"
          >
            Hospitals
          </h3>
          <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Hospitals & Clinics</p>
        </a>

        <a
          href="/weather/"
          class="rounded-2xl border border-gray-100 dark:border-gray-700 p-6 transition hover:bg-gray-50 dark:hover:bg-gray-800/50 group"
        >
          <h3
            class="font-semibold dark:text-gray-100 group-hover:text-theme-600 dark:group-hover:text-theme-400"
          >
            Weather
          </h3>
          <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Current & 3-day forecast</p>
        </a>

        <a
          href="/house-of-workships/"
          class="rounded-2xl border border-gray-100 dark:border-gray-700 p-6 transition hover:bg-gray-50 dark:hover:bg-gray-800/50 group"
        >
          <h3
            class="font-semibold dark:text-gray-100 group-hover:text-theme-600 dark:group-hover:text-theme-400"
          >
            Houses of Worship
          </h3>
          <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Temples and Churches</p>
        </a>
      </div>
    </section>
  </div>
  <!-- /constrained content -->
</main>

<script>
  (function () {
    // Weather Widget
    (function () {
      var loading = document.getElementById('weatherWidgetLoading');
      var content = document.getElementById('weatherWidgetContent');

      if (!loading || !content) return;

      // ── Lucide SVG paths for weather icons ──
      var WEATHER_ICONS = {
        sun: [
          '<circle cx="12" cy="12" r="4"/>',
          '<path d="M12 2v2"/>',
          '<path d="M12 20v2"/>',
          '<path d="m4.93 4.93 1.41 1.41"/>',
          '<path d="m17.66 17.66 1.41 1.41"/>',
          '<path d="M2 12h2"/>',
          '<path d="M20 12h2"/>',
          '<path d="m6.34 17.66-1.41 1.41"/>',
          '<path d="m19.07 4.93-1.41 1.41"/>',
        ],
        'cloud-sun': [
          '<path d="M12 2v2"/>',
          '<path d="m4.93 4.93 1.41 1.41"/>',
          '<path d="M20 12h2"/>',
          '<path d="m19.07 4.93-1.41 1.41"/>',
          '<path d="M15.947 12.65a4 4 0 0 0-5.925-4.128"/>',
          '<path d="M13 22H7a5 5 0 1 1 4.9-6H13a3 3 0 0 1 0 6Z"/>',
        ],
        cloud: ['<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>'],
        'cloud-fog': [
          '<path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/>',
          '<path d="M16 17H7"/>',
          '<path d="M17 21H9"/>',
        ],
        'cloud-drizzle': [
          '<path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/>',
          '<path d="M8 19v1"/>',
          '<path d="M8 14v1"/>',
          '<path d="M16 19v1"/>',
          '<path d="M16 14v1"/>',
          '<path d="M12 21v1"/>',
          '<path d="M12 16v1"/>',
        ],
        'cloud-rain': [
          '<path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/>',
          '<path d="M16 14v6"/>',
          '<path d="M8 14v6"/>',
          '<path d="M12 16v6"/>',
        ],
        'cloud-lightning': [
          '<path d="M6 16.326A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 .5 8.973"/>',
          '<path d="m13 12-3 5h4l-3 5"/>',
        ],
        'cloud-snow': [
          '<path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/>',
          '<path d="M8 15h.01"/>',
          '<path d="M8 19h.01"/>',
          '<path d="M12 17h.01"/>',
          '<path d="M12 21h.01"/>',
          '<path d="M16 15h.01"/>',
          '<path d="M16 19h.01"/>',
        ],
      };

      var CODE_TO_ICON = {
        0: 'sun',
        1: 'sun',
        2: 'cloud-sun',
        3: 'cloud',
        45: 'cloud-fog',
        48: 'cloud-fog',
        51: 'cloud-drizzle',
        53: 'cloud-drizzle',
        55: 'cloud-drizzle',
        56: 'cloud-drizzle',
        57: 'cloud-drizzle',
        61: 'cloud-rain',
        63: 'cloud-rain',
        65: 'cloud-rain',
        66: 'cloud-rain',
        67: 'cloud-rain',
        71: 'cloud-snow',
        73: 'cloud-snow',
        75: 'cloud-snow',
        77: 'cloud-snow',
        80: 'cloud-rain',
        81: 'cloud-rain',
        82: 'cloud-rain',
        85: 'cloud-snow',
        86: 'cloud-snow',
        95: 'cloud-lightning',
        96: 'cloud-lightning',
        99: 'cloud-lightning',
      };

      var LABELS = {
        0: 'Clear',
        1: 'Mostly clear',
        2: 'Partly cloudy',
        3: 'Overcast',
        45: 'Foggy',
        48: 'Foggy',
        51: 'Drizzle',
        53: 'Drizzle',
        55: 'Drizzle',
        56: 'Freezing drizzle',
        57: 'Freezing drizzle',
        61: 'Light rain',
        63: 'Moderate rain',
        65: 'Heavy rain',
        66: 'Freezing rain',
        67: 'Freezing rain',
        71: 'Light snow',
        73: 'Moderate snow',
        75: 'Heavy snow',
        77: 'Snow grains',
        80: 'Rain showers',
        81: 'Rain showers',
        82: 'Rain showers',
        85: 'Snow showers',
        86: 'Snow showers',
        95: 'Thunderstorm',
        96: 'Thunderstorm',
        99: 'Thunderstorm',
      };

      function makeIcon(iconName) {
        var paths = WEATHER_ICONS[iconName] || WEATHER_ICONS.cloud;
        var ns = 'http://www.w3.org/2000/svg';
        var svg = document.createElementNS(ns, 'svg');
        svg.setAttribute('xmlns', ns);
        svg.setAttribute('width', '100%');
        svg.setAttribute('height', '100%');
        svg.setAttribute('viewBox', '0 0 24 24');
        svg.setAttribute('fill', 'none');
        svg.setAttribute('stroke', 'currentColor');
        svg.setAttribute('stroke-width', '2');
        svg.setAttribute('stroke-linecap', 'round');
        svg.setAttribute('stroke-linejoin', 'round');
        paths.forEach(function (d) {
          var temp = document.createElementNS(ns, 'g');
          temp.innerHTML = d;
          while (temp.firstChild) svg.appendChild(temp.firstChild);
        });
        return svg;
      }

      function formatDay(dateStr) {
        var date = new Date(dateStr + 'T12:00:00');
        var today = new Date();
        var tomorrow = new Date(today);
        tomorrow.setDate(tomorrow.getDate() + 1);
        if (date.toDateString() === today.toDateString()) return 'Today';
        if (date.toDateString() === tomorrow.toDateString()) return 'Tomorrow';
        return date.toLocaleDateString('en-IN', { weekday: 'long' });
      }

      function renderWidget(data) {
        var c = data.current;
        var daily = data.daily;
        var iconName = CODE_TO_ICON[c.weather_code] || 'cloud';
        var label = LABELS[c.weather_code] || 'Unknown';

        var iconContainer = document.getElementById('weatherWidgetIcon');
        iconContainer.innerHTML = '';
        iconContainer.appendChild(makeIcon(iconName));

        document.getElementById('weatherWidgetTemp').textContent = Math.round(c.temperature_2m);
        document.getElementById('weatherWidgetDesc').textContent = label;
        document.getElementById('weatherWidgetHumidity').textContent = c.relative_humidity_2m;
        document.getElementById('weatherWidgetWind').textContent = Math.round(c.wind_speed_10m);

        // Render 3-day forecast as table rows
        var table = document.getElementById('weatherWidgetForecast');
        var tbody =
          table &&
          (table.querySelector('tbody') ||
            (function () {
              var tb = document.createElement('tbody');
              table.appendChild(tb);
              return tb;
            })());
        tbody.innerHTML = '';
        if (daily && daily.time) {
          for (var i = 0; i < daily.time.length; i++) {
            var dayIcon = CODE_TO_ICON[daily.weather_code[i]] || 'cloud';
            var row = document.createElement('tr');
            row.className = 'border-b border-gray-100 dark:border-gray-700 last:border-b-0';

            // Day name
            var dayTd = document.createElement('td');
            dayTd.className = 'py-1.5 text-gray-500 dark:text-gray-400 font-medium';
            dayTd.textContent = formatDay(daily.time[i]);
            row.appendChild(dayTd);

            // Icon
            var iconTd = document.createElement('td');
            iconTd.className = 'py-1.5 text-center w-6';
            iconTd.setAttribute('aria-hidden', 'true');
            var iconWrap = document.createElement('div');
            iconWrap.className = 'w-4 h-4 mx-auto text-theme-400 dark:text-theme-400';
            iconWrap.appendChild(makeIcon(dayIcon));
            iconTd.appendChild(iconWrap);
            row.appendChild(iconTd);

            // High temp
            var highTd = document.createElement('td');
            highTd.className = 'py-1.5 text-right font-bold text-gray-900 dark:text-gray-100';
            highTd.textContent = Math.round(daily.temperature_2m_max[i]) + '°';
            row.appendChild(highTd);

            // Low temp
            var lowTd = document.createElement('td');
            lowTd.className = 'py-1.5 text-right text-gray-400 dark:text-gray-500';
            lowTd.textContent = Math.round(daily.temperature_2m_min[i]) + '°';
            row.appendChild(lowTd);

            tbody.appendChild(row);
          }
        }

        loading.classList.add('hidden');
        content.classList.remove('hidden');
      }

      function getTodayKey() {
        return new Date().toISOString().slice(0, 10);
      }

      // Check localStorage cache first
      var today = getTodayKey();
      var cached = null;
      try {
        var raw = localStorage.getItem('piravom_weather');
        if (raw) {
          var parsed = JSON.parse(raw);
          if (parsed.cachedAt === today) cached = parsed.data;
        }
      } catch (e) {
        /* ignore */
      }

      if (cached && cached.current) {
        renderWidget(cached);
      } else {
        fetch(
          'https://api.open-meteo.com/v1/forecast?' +
            'latitude=9.87&longitude=76.49' +
            '&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m' +
            '&daily=temperature_2m_max,temperature_2m_min,weather_code' +
            '&timezone=auto&forecast_days=3',
        )
          .then(function (r) {
            return r.ok ? r.json() : Promise.reject();
          })
          .then(function (data) {
            // Cache in localStorage
            try {
              localStorage.setItem(
                'piravom_weather',
                JSON.stringify({ cachedAt: today, data: data }),
              );
            } catch (e) {
              /* ignore */
            }
            renderWidget(data);
          })
          .catch(function () {
            loading.classList.add('hidden');
            content.classList.remove('hidden');
            var iconContainer = document.getElementById('weatherWidgetIcon');
            iconContainer.innerHTML = '';
            iconContainer.appendChild(makeIcon('cloud'));
            document.getElementById('weatherWidgetTemp').textContent = '--';
            document.getElementById('weatherWidgetDesc').textContent = 'Unavailable';
          });
      }
    })();
  })();
</script>
